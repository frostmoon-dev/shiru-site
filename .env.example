# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# All are optional. Variables prefixed PUBLIC_ end up in client code: never put secrets in them.

# Canonical site URL used for <link rel="canonical">, Open Graph and sitemap.xml.
# If unset on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used; otherwise https://shiru.example.
SITE_URL=

# Form endpoint that accepts a JSON POST and answers 2xx on success
# (e.g. a Formspree form URL). If unset, the contact form falls back to mailto:.
PUBLIC_CONTACT_ENDPOINT=
