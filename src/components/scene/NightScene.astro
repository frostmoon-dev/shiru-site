---
/** Burton-style night: crooked moon, curling clouds, a spiral hill, one twisted tree. Decorative. */
---

<svg class="night-scene" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ns-sky" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#0c0b11"></stop>
      <stop offset=".55" stop-color="#1a1922"></stop>
      <stop offset="1" stop-color="#262231"></stop>
    </linearGradient>
    <radialGradient id="ns-glow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(930 230) scale(330)">
      <stop offset="0" stop-color="#d9d2bd" stop-opacity=".22"></stop>
      <stop offset="1" stop-color="#d9d2bd" stop-opacity="0"></stop>
    </radialGradient>
    <mask id="ns-crescent">
      <rect width="1440" height="900" fill="#fff"></rect>
      <ellipse cx="972" cy="196" rx="104" ry="100" fill="#000"></ellipse>
    </mask>
  </defs>

  <rect width="1440" height="900" fill="url(#ns-sky)"></rect>
  <!-- pinstripe sky, barely there -->
  <g stroke="#d9d2bd" stroke-opacity=".025" stroke-width="2">
    {Array.from({ length: 36 }, (_, i) => <line x1={i * 40} y1="0" x2={i * 40 + 30} y2="900" />)}
  </g>
  <g fill="#d9d2bd">
    <circle cx="210" cy="120" r="1.6" opacity=".5"></circle>
    <circle cx="420" cy="70" r="1.2" opacity=".4"></circle>
    <circle cx="610" cy="160" r="1" opacity=".35"></circle>
    <circle cx="1240" cy="110" r="1.4" opacity=".45"></circle>
    <circle cx="1330" cy="260" r="1" opacity=".3"></circle>
    <circle cx="760" cy="60" r="1.3" opacity=".4"></circle>
    <circle cx="90" cy="300" r="1" opacity=".3"></circle>
  </g>

  <circle cx="930" cy="230" r="330" fill="url(#ns-glow)"></circle>
  <!-- crooked moon: a tilted crescent with an uneven rim -->
  <g transform="rotate(-17 930 230)" class="night-scene__moon">
    <path
      mask="url(#ns-crescent)"
      fill="#d9d2bd"
      d="M930 118c62-2 114 46 116 110 3 66-46 120-112 122-64 2-118-48-120-112-2-62 52-118 116-120z"></path>
    <path fill="none" stroke="#c9b48c" stroke-opacity=".5" stroke-width="2" d="M842 200c6 28 22 50 46 64M866 300c18 12 40 18 62 18"></path>
  </g>

  <!-- curling cloud lines -->
  <g fill="none" stroke="#d9d2bd" stroke-linecap="round" stroke-opacity=".22" stroke-width="2.4">
    <path d="M560 320c60-34 150-40 220-10 36 16 40 52 10 60-24 6-38-18-22-30 14-10 30 0 26 12"></path>
    <path d="M1040 380c70-20 160-14 230 12 30 12 30 44 4 46-20 2-28-20-14-28"></path>
    <path d="M120 230c50-24 110-26 160-6 26 10 26 38 4 40-16 1-22-16-10-22"></path>
  </g>

  <!-- far hills -->
  <path fill="#15131c" d="M0 640c200-80 380-40 520 10 180 50 380-30 580-10 150 15 250-20 340-40V900H0z"></path>

  <!-- spiral hill (middle ground, left) -->
  <path
    fill="#0e0c13"
    d="M0 700c90-10 170-60 230-140 50-70 80-140 140-170 60-28 112 0 112 50 0 40-36 62-64 50-22-10-16-40 8-38-14-14-44-8-50 14-8 32 26 60 62 56 52-6 80-60 64-112-18-62-90-86-150-58-70 32-100 108-120 170-20 64-12 130 40 186 46 50 120 76 210 90 140 20 260 30 340 102H0z"
  ></path>
  <path fill="none" stroke="#d9d2bd" stroke-opacity=".08" stroke-width="2" d="M230 560c50-70 80-140 140-170 60-28 112 0 112 50"></path>

  <!-- twisted tree (foreground, right) -->
  <g fill="none" stroke="#050304" stroke-linecap="round" stroke-linejoin="round">
    <path stroke-width="34" d="M1250 905c-12-100 40-160 10-260-20-70 20-120 40-170"></path>
    <path stroke-width="14" d="M1262 650c-62-40-102-50-142-90-25-25-10-55 15-45 15 7 10 25-3 23"></path>
    <path stroke-width="11" d="M1290 500c40-40 90-50 110-90 12-24-2-45-20-38-12 6-8 20 4 18"></path>
    <path stroke-width="9" d="M1300 470c-5-50-40-80-60-120-12-25 5-45 22-35"></path>
    <path stroke-width="6" d="M1180 585c-10-25-30-37-40-55"></path>
    <path stroke-width="7" d="M1275 560c55-15 95 0 135-20 18-9 26-26 16-36"></path>
    <path stroke-width="4" d="M1240 350c-24-6-40-22-46-40"></path>
  </g>

  <!-- foreground ground -->
  <path fill="#08070b" d="M0 860c300-20 700 10 1000-10 200-12 350 0 440-5V900H0z"></path>
</svg>

<style>
  .night-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
