---
/**
 * Static SVG ink edge: the no-WebGL / reduced-motion / no-JS version of the ink-edge shader.
 * Generated deterministically so it never shifts between builds.
 */
interface Props {
  rest?: number; // fraction of height where the ink line sits
  drips?: number;
  seed?: number;
}
const { rest = 0.18, drips = 14, seed = 7 } = Astro.props;
let s = seed;
const rand = () => {
  s = (s * 16807) % 2147483647;
  return (s - 1) / 2147483646;
};
const W = 1000;
const H = 300;
const base = rest * H;
const pts: string[] = [];
for (let x = 0; x <= W; x += 25) {
  const u = x / W;
  const creep = 46 * (Math.max(0, 0.3 - u) / 0.3) ** 2 + 46 * (Math.max(0, u - 0.7) / 0.3) ** 2;
  const y = base + Math.sin(u * 11) * 4 + Math.sin(u * 27 + 1) * 2.5 + creep;
  pts.push(`${x},${y.toFixed(1)}`);
}
const edge = `M0,0 L${W},0 L${pts.reverse().join(' L')} Z`;
const dripList = Array.from({ length: drips }, () => {
  const x = 30 + rand() * 940;
  const w = 3 + rand() * 7;
  const len = 18 + rand() * 80;
  const y0 = base - 4;
  const d = `M${(x - w).toFixed(1)},${y0} C${(x - w).toFixed(1)},${(y0 + len * 0.6).toFixed(1)} ${(x - w * 1.5).toFixed(1)},${(y0 + len).toFixed(1)} ${x.toFixed(1)},${(y0 + len + w).toFixed(1)} C${(x + w * 1.5).toFixed(1)},${(y0 + len).toFixed(1)} ${(x + w).toFixed(1)},${(y0 + len * 0.6).toFixed(1)} ${(x + w).toFixed(1)},${y0} Z`;
  return { d, dur: (5 + rand() * 6).toFixed(1), delay: (-rand() * 6).toFixed(1), x };
});
---

<svg class="ink-fallback" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ink-fade" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#050304" stop-opacity="0"></stop>
      <stop offset={rest * 0.85} stop-color="#050304" stop-opacity="1"></stop>
    </linearGradient>
  </defs>
  <path d={edge} fill="url(#ink-fade)"></path>
  <g fill="#050304">
    {
      dripList.map((dr) => (
        <path class="ink-fallback__drip" d={dr.d} style={`--dur:${dr.dur}s;--delay:${dr.delay}s;transform-origin:${dr.x}px ${base}px`} />
      ))
    }
  </g>
</svg>

<style>
  .ink-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ink-fallback__drip {
    transform-box: view-box;
    animation: drip-breathe var(--dur) var(--ease-ink) var(--delay) infinite alternate;
  }
  :global([data-static='true']) .ink-fallback__drip,
  :global(html:not(.js)) .ink-fallback__drip {
    animation: none;
  }
  @keyframes drip-breathe {
    from {
      transform: scaleY(0.55);
    }
    to {
      transform: scaleY(1.25);
    }
  }
</style>
