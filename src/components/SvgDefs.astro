---
/** Shared SVG filters. Referenced from CSS and effects by id. */
---

<svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <!-- Torn paper edge. -->
    <filter id="ink-rough" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" seed="8"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="9"></feDisplacementMap>
    </filter>
  </defs>
</svg>

<style>
  .svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
