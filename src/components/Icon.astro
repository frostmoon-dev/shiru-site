---
/**
 * Hand-drawn icons for this site only. Always decorative here: the button or link that
 * contains an icon carries the accessible name.
 */
type Name = 'close' | 'sound-on' | 'sound-off' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'warn' | 'check' | 'quill' | 'download';
interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls } = Astro.props;
---

<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'close' && <path d="M5.2 4.6c3.1 3.6 9.4 10.6 13.9 14.9M18.6 4.9C15 8.1 8.9 14.8 5.1 19.3" />}
  {
    name === 'sound-on' && (
      <>
        <path d="M3.5 9.2h3.3l5.1-4.3v14.3l-5.1-4.4H3.6z" />
        <path d="M15.2 8.6c1.4 1.9 1.5 4.6.1 6.7M17.9 6.1c2.8 3.4 2.9 8.3.2 11.9" />
      </>
    )
  }
  {
    name === 'sound-off' && (
      <>
        <path d="M3.5 9.2h3.3l5.1-4.3v14.3l-5.1-4.4H3.6z" />
        <path d="M15.4 9.3l5.2 5.3M20.5 9.1l-5 5.6" />
      </>
    )
  }
  {name === 'arrow-down' && <path d="M12.2 3.6c-.4 5.4.1 11 .1 16.3M6.8 14.6c2 1.8 3.9 3.6 5.4 5.6 1.6-2.3 3.4-4 5.2-5.7" />}
  {name === 'arrow-left' && <path d="M20.4 12.3c-5.5-.4-11 .2-16.4.1M9.3 6.6C7.6 8.6 5.6 10.5 4 12.2c2.2 1.7 4 3.4 5.6 5.3" />}
  {name === 'arrow-right' && <path d="M3.6 11.8c5.5.4 11-.2 16.4-.1M14.7 6.5c1.7 2 3.7 3.9 5.3 5.6-2.2 1.7-4 3.4-5.6 5.3" />}
  {
    name === 'warn' && (
      <>
        <path d="M12 3.4c-3.1 5.5-5.9 10.9-8.6 16.6 5.7.3 11.5.2 17.2-.1C17.9 14.2 15 8.7 12 3.4z" />
        <path d="M12 9.2v5.2M12 17.3v.2" />
      </>
    )
  }
  {name === 'check' && <path d="M4.2 12.9c1.9 1.6 3.6 3.4 5.1 5.4 3-4.8 6.5-9.1 10.6-12.9" />}
  {name === 'download' && <path d="M12.1 3.7c-.3 4.4.1 8.8 0 13M7.4 12.4c1.7 1.5 3.3 3 4.7 4.6 1.4-1.8 3-3.3 4.6-4.8M4.6 20.1c4.9.3 9.9-.1 14.8.1" />}
  {name === 'quill' && <path d="M19.8 3.8C13 5 8 10.4 5.4 18.6M19.8 3.8c-.9 4.9-4.3 9.2-9.9 11.4M4.2 20.2l1.2-1.6" />}
</svg>
