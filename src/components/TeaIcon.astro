---
/** Contact icons drawn for this site (line style, like the design). Decorative: links carry the name. */
interface Props {
  name: 'mail' | 'linkedin' | 'github' | 'link' | 'instagram' | 'x' | 'tiktok';
}
const { name } = Astro.props;
---

<svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    name === 'mail' && (
      <>
        <rect x="3.5" y="7" width="25" height="18" rx="1.5" />
        <path d="M4.5 8.5 16 17.5l11.5-9" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="4" y="4" width="24" height="24" rx="3" />
        <path d="M10.5 14v8.5M10.5 10.2v.1M15 22.5V14M15 17.6c0-2.2 1.6-3.8 3.5-3.8 2 0 3.3 1.5 3.3 3.9v4.8" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="4.5" y="4.5" width="23" height="23" rx="6.5" />
        <circle cx="16" cy="16" r="5.2" />
        <path d="M22.6 9.4v.1" />
      </>
    )
  }
  {
    name === 'x' && (
      <>
        <path d="M6 5.5 25.5 26.5h1" />
        <path d="M26 5.5 17.6 14.6M14.4 18 6 26.5" />
        <path d="M5.5 5.5H11L26.5 26.5H21Z" />
      </>
    )
  }
  {
    name === 'tiktok' && (
      <>
        <path d="M18 4.5v15.3a4.8 4.8 0 1 1-4.8-4.8" />
        <path d="M18 4.5c.4 3.4 2.8 6 6.5 6.3" />
      </>
    )
  }
  {
    name === 'link' && (
      <>
        <path d="M13.5 18.5a5 5 0 0 0 7.1 0l4-4a5 5 0 0 0-7.1-7.1l-1.7 1.7" />
        <path d="M18.5 13.5a5 5 0 0 0-7.1 0l-4 4a5 5 0 0 0 7.1 7.1l1.7-1.7" />
      </>
    )
  }
  {
    name === 'github' && (
      <>
        <path d="M16 4.5c-6.5 0-11.5 5-11.5 11.4 0 5 3.2 9.3 7.7 10.8v-3.6c-3 .6-3.8-1.4-4-2.2-.3-.7-1-1.5-1.6-1.8" />
        <path d="M19.8 26.7v-3.9c0-1.2-.4-2-1-2.5 3.4-.4 6.3-1.7 6.3-6.6 0-1.4-.5-2.6-1.3-3.5.2-.6.5-2-.2-3.6 0 0-1.1-.3-3.6 1.3a12 12 0 0 0-6.3 0C11.2 6.3 10.1 6.6 10.1 6.6c-.7 1.6-.4 3-.2 3.6-.8.9-1.3 2.1-1.3 3.5 0 4.9 2.9 6.2 6.3 6.6-.4.4-.8 1-.9 2" />
        <path d="M19.8 26.7c4.5-1.5 7.7-5.8 7.7-10.8" />
      </>
    )
  }
</svg>
