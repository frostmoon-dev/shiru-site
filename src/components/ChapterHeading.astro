---
/**
 * Every chapter opens the same way (consistency): a typewriter label, then a bleeding
 * Federant title. Pass `drip` to pick the drip colour that suits the section's tone.
 */
interface Props {
  id: string;
  label: string;
  title: string;
  drip?: string;
  level?: 'h1' | 'h2';
  class?: string;
}
const { id, label, title, drip = '#a3141b', level = 'h2', class: cls } = Astro.props;
const Tag = level;
---

<header class:list={['chapter-heading', cls]}>
  <p class="chapter-heading__label label">{label}</p>
  <Tag id={id} class="chapter-heading__title" data-effect="bleed-title" data-effect-options={JSON.stringify({ color: drip, density: 0.55 })}>
    <span class="bleed__text">{title}</span>
  </Tag>
</header>

<style>
  .chapter-heading__label {
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
  }
  .chapter-heading__label::before {
    content: '';
    display: inline-block;
    width: 2.4em;
    height: 1px;
    background: currentColor;
    vertical-align: middle;
    margin-right: 0.8em;
  }
  .chapter-heading__title {
    font-size: var(--step-5);
    color: var(--accent-text);
    line-height: 1;
    max-width: 16ch;
  }
</style>
