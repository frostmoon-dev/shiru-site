---
/** Small storybook props: keys, playing cards, a DRINK ME tag. All decorative. */
type Kind = 'key' | 'card-hearts' | 'card-spades' | 'drink-me' | 'rose';
interface Props {
  kind: Kind;
  size?: number;
  class?: string;
}
const { kind, size = 90, class: cls } = Astro.props;
---

{
  kind === 'key' && (
    <svg class:list={['prop', cls]} width={size} height={size * 0.45} viewBox="0 0 200 90" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#c9a24a" stroke-width="7" stroke-linecap="round">
        <circle cx="38" cy="45" r="26" />
        <circle cx="38" cy="45" r="9" stroke-width="4" />
        <path d="M64 45h120M150 45v24M168 45v18M184 45v26" />
      </g>
    </svg>
  )
}
{
  (kind === 'card-hearts' || kind === 'card-spades') && (
    <svg class:list={['prop', cls]} width={size} height={size * 1.4} viewBox="0 0 100 140" aria-hidden="true" focusable="false">
      <rect x="2" y="2" width="96" height="136" rx="5" fill="#e8dcc2" stroke="#2a1a12" stroke-width="2" />
      <rect x="9" y="9" width="82" height="122" rx="2" fill="none" stroke={kind === 'card-hearts' ? '#a3141b' : '#2a1a12'} stroke-width=".8" stroke-dasharray="3 2" />
      <text x="14" y="28" font-family="serif" font-size="18" fill={kind === 'card-hearts' ? '#a3141b' : '#2a1a12'}>
        {kind === 'card-hearts' ? 'Q' : 'VII'}
      </text>
      {kind === 'card-hearts' ? (
        <path d="M50 98c-24-16-30-30-24-40 6-9 19-8 24 2 5-10 18-11 24-2 6 10 0 24-24 40z" fill="#a3141b" />
      ) : (
        <path d="M50 46c-22 18-30 30-24 40 5 8 15 7 20 1-1 7-4 12-8 15h24c-4-3-7-8-8-15 5 6 15 7 20-1 6-10-2-22-24-40z" fill="#2a1a12" />
      )}
    </svg>
  )
}
{
  kind === 'drink-me' && (
    <svg class:list={['prop', cls]} width={size} height={size * 0.6} viewBox="0 0 160 96" aria-hidden="true" focusable="false">
      <path d="M8 18h120l24 30-24 30H8z" fill="#c9b48c" stroke="#2a1a12" stroke-width="2" />
      <circle cx="132" cy="48" r="6" fill="#1a1922" />
      <path d="M138 48c14-6 18-18 14-30" fill="none" stroke="#5c0e12" stroke-width="2" />
      <text x="20" y="57" font-family="serif" font-size="22" letter-spacing="2" fill="#2a1a12">
        DRINK ME
      </text>
    </svg>
  )
}
{
  kind === 'rose' && (
    <svg class:list={['prop', cls]} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <path d="M50 92c2-20-2-36 0-52" stroke="#2b1215" stroke-width="3" fill="none" />
      <path d="M50 70c-12-2-20-10-22-18 10 0 18 6 22 18z" fill="#2b1215" />
      <circle cx="50" cy="32" r="18" fill="#a3141b" />
      <path d="M50 32c4-3 8 1 6 5-3 5-11 4-13-2-2-8 6-14 14-12 9 3 12 13 8 20" fill="none" stroke="#5c0e12" stroke-width="2" />
    </svg>
  )
}
