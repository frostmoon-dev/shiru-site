---
/** A pocket-watch face whose numerals run anticlockwise and whose hands do too. */
interface Props {
  size?: number;
  speed?: number;
  class?: string;
}
const { size = 120, speed = 1, class: cls } = Astro.props;
const numerals = ['XII', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI'];
---

<svg class:list={['bclock', cls]} width={size} height={size} viewBox="0 0 120 120" aria-hidden="true" focusable="false" style={`--speed:${speed}`}>
  <circle cx="60" cy="60" r="56" fill="#e8dcc2" stroke="#c9a24a" stroke-width="4"></circle>
  <circle cx="60" cy="60" r="50" fill="none" stroke="#2a1a12" stroke-width=".8" stroke-dasharray="1 4.2"></circle>
  <rect x="55" y="-2" width="10" height="8" rx="2" fill="#c9a24a"></rect>
  {
    numerals.map((n, i) => {
      const a = (-i * 30 - 90) * (Math.PI / 180); // anticlockwise
      return (
        <text x={60 + Math.cos(a) * 40} y={60 + Math.sin(a) * 40 + 3} text-anchor="middle" font-size="8" fill="#2a1a12" font-family="serif">
          {n}
        </text>
      );
    })
  }
  <g class="bclock__hour"><path d="M60 60 L60 34" stroke="#2a1a12" stroke-width="3" stroke-linecap="round"></path></g>
  <g class="bclock__min"><path d="M60 60 L60 20" stroke="#a3141b" stroke-width="1.6" stroke-linecap="round"></path></g>
  <circle cx="60" cy="60" r="3" fill="#2a1a12"></circle>
</svg>

<style>
  .bclock__hour,
  .bclock__min {
    transform-origin: 60px 60px;
    animation: backwards linear infinite;
  }
  .bclock__min {
    animation-duration: calc(14s / var(--speed));
  }
  .bclock__hour {
    animation-duration: calc(168s / var(--speed));
  }
  @keyframes backwards {
    to {
      transform: rotate(-360deg);
    }
  }
</style>
