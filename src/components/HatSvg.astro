---
/** The wide-brimmed witch hat. Elegant, slightly crooked, never a cartoon cone. */
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={['hat-svg', cls]} viewBox="0 0 220 170" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="hat-crown" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#2a2533"></stop>
      <stop offset=".45" stop-color="#15121a"></stop>
      <stop offset="1" stop-color="#0b090d"></stop>
    </linearGradient>
    <linearGradient id="hat-brim" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#231f2b"></stop>
      <stop offset="1" stop-color="#08060a"></stop>
    </linearGradient>
  </defs>
  <g class="hat-svg__body">
    <!-- brim, curling up at both ends -->
    <path
      fill="url(#hat-brim)"
      d="M6 116c6-6 14-8 22-6 22-9 52-13 82-13s62 4 84 13c8-2 16 0 21 6-4 1-9 2-13 4-21 12-55 19-92 19s-70-7-91-19c-4-2-9-3-13-4z"
    ></path>
    <path fill="none" stroke="#d9d2bd" stroke-opacity=".22" stroke-width="1.2" d="M28 110c22-9 52-13 82-13s62 4 84 13"></path>
    <!-- crown with a bent, crooked tip -->
    <path
      fill="url(#hat-crown)"
      d="M64 111c4-21 11-42 21-61 9-17 20-31 34-40 11-7 24-9 36-6-12 3-22 9-29 18-7 10-9 21-7 33 3 19 15 36 26 56-26 6-56 6-81 0z"
    ></path>
    <path fill="none" stroke="#d9d2bd" stroke-opacity=".18" stroke-width="1" d="M70 106c4-19 10-38 19-55 9-16 19-28 32-36"></path>
    <!-- band + brass buckle -->
    <path fill="#5c0e12" d="M65 100c26 6 54 6 80 0l2 11c-27 7-57 7-84 0z"></path>
    <rect x="96" y="99" width="16" height="15" rx="1" fill="none" stroke="#c9a24a" stroke-width="2.4"></rect>
    <!-- a single rose on the band -->
    <g transform="translate(76 104)">
      <circle r="7" fill="#a3141b"></circle>
      <path fill="none" stroke="#5c0e12" stroke-width="1.2" d="M0 0c2-1 3 1 2 3-2 2-5 1-6-2 0-4 4-6 7-5 4 1 5 5 4 8"></path>
      <path fill="#2b1215" d="M-9 4c-4 3-8 3-11 1 3-3 7-4 11-1z"></path>
    </g>
  </g>
</svg>
