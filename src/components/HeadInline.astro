---
/**
 * Runs before first paint and before Astro's router module, on purpose:
 * 1. marks <html class="js"> so no-JS visitors get the static story,
 * 2. decides whether the intro plays (once per session, home page only),
 * 3. owns the overlay history so Esc, close buttons and the browser Back button all close
 *    overlays without Astro's router treating Back as a page navigation.
 */
interface Props {
  intro?: boolean;
}
const { intro = false } = Astro.props;
---

<script is:inline define:vars={{ intro }}>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    // Client-side navigations copy <html>'s attributes from the new page, which never ran this
    // script: carry the class over, or JS-only styles (sound toggle, letter, book) fall back.
    document.addEventListener('astro:before-swap', function (e) {
      e.newDocument.documentElement.classList.add('js');
    });
    // home page starts at the hero: set the hero layout before first paint (no jump later)
    if (intro && !location.hash) root.classList.add('at-hero');
    try {
      // Deep links (/#tea) go straight to the content: no intro in the way.
      if (intro && !location.hash && !sessionStorage.getItem('site:intro-seen')) {
        root.classList.add('intro-pending');
        // Fail-safe: if the intro script never starts, the page is never held hostage.
        window.__introFailsafe = window.setTimeout(function () {
          root.classList.remove('intro-pending');
          window.dispatchEvent(new Event('site:intro-done'));
        }, 3500);
      }
    } catch (e) {
      /* storage blocked: skip the intro */
    }

    var stack = [];
    var docPath = location.pathname;
    var pending = null;
    function run(fn) {
      if (typeof fn === 'function') window.setTimeout(fn, 0);
    }
    window.siteOverlay = {
      open: function (id, close) {
        var state = Object.assign({}, history.state || {}, { siteOverlay: id });
        history.pushState(state, '');
        stack.push({ id: id, close: close });
      },
      close: function (id, then) {
        var top = stack[stack.length - 1];
        if (top && top.id === id && history.state && history.state.siteOverlay === id) {
          pending = then || null;
          history.back();
          return;
        }
        for (var i = stack.length - 1; i >= 0; i--) {
          if (stack[i].id === id) {
            var item = stack.splice(i, 1)[0];
            item.close();
          }
        }
        run(then);
      },
      isOpen: function (id) {
        return stack.some(function (s) {
          return s.id === id;
        });
      },
    };
    window.addEventListener('popstate', function (e) {
      if (location.pathname !== docPath) return; // a real page change: Astro's router handles it
      var st = e.state || {};
      var top = stack[stack.length - 1];
      if (top && st.siteOverlay !== top.id) {
        e.stopImmediatePropagation();
        stack.pop();
        top.close();
        var then = pending;
        pending = null;
        run(then);
        return;
      }
      if (st.siteOverlay) e.stopImmediatePropagation(); // stale overlay entry (Forward): ignore
    });
    document.addEventListener('astro:after-swap', function () {
      stack.length = 0;
      docPath = location.pathname;
    });
  })();
</script>
