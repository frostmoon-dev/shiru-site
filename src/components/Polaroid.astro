---
import { Picture } from 'astro:assets';
import type { CaseFile } from '../content/site';
import { casePhotos } from '../content/photos';

interface Props {
  file: CaseFile;
  index: number;
}
const { file, index } = Astro.props;
const photo = casePhotos[file.photo];
---

<li class="polaroid-wrap" style={`--rot:${file.rotation}deg; --i:${index}`}>
  <a class="polaroid" href={`/case-files/${file.slug}/`} data-no-bleed>
    <span class="polaroid__pin" aria-hidden="true"></span>
    <span class="polaroid__photo" transition:name={`case-photo-${file.slug}`} data-effect="flicker-jitter" data-effect-options='{"every":[6,18]}'>
      <Picture
        src={photo}
        alt={file.photoAlt}
        formats={['avif', 'webp']}
        widths={[280, 420, 560]}
        sizes="(max-width: 719px) 70vw, 280px"
        loading="lazy"
        decoding="async"
      />
    </span>
    <span class="polaroid__caption">
      <span class="polaroid__no label">{file.number}</span>
      <span class="polaroid__title" transition:name={`case-title-${file.slug}`}>{file.title}</span>
      <span class="polaroid__stamp label">{file.stamp}</span>
    </span>
  </a>
</li>

<style>
  .polaroid-wrap {
    list-style: none;
  }
  .polaroid {
    position: relative;
    display: block;
    width: 100%;
    padding: var(--space-2) var(--space-2) var(--space-3);
    background: var(--bone);
    color: var(--ink);
    text-decoration: none;
    transform: rotate(var(--rot));
    box-shadow:
      0 1px 0 rgb(255 250 235 / 0.4) inset,
      8px 14px 0 rgb(5 3 4 / 0.55);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .polaroid:hover,
  .polaroid:focus-visible {
    transform: rotate(calc(var(--rot) * 0.3)) translateY(-6px) scale(1.02);
    box-shadow:
      0 1px 0 rgb(255 250 235 / 0.4) inset,
      14px 22px 0 rgb(5 3 4 / 0.6);
  }
  .polaroid:active {
    transform: rotate(0deg) scale(0.99);
  }
  .polaroid:focus-visible {
    outline-color: var(--bone);
    box-shadow: 0 0 0 6px var(--void);
  }
  .polaroid__pin {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--brass-hi), var(--brass-lo) 70%);
    box-shadow: 2px 3px 0 rgb(5 3 4 / 0.6);
  }
  .polaroid__photo {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--leather);
  }
  .polaroid__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.35) contrast(1.05);
  }
  .polaroid__caption {
    display: grid;
    gap: var(--space-half);
    margin-top: var(--space-2);
  }
  .polaroid__no {
    color: var(--ink-muted);
  }
  .polaroid__title {
    font-family: var(--font-flavour);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .polaroid__stamp {
    justify-self: start;
    margin-top: var(--space-1);
    padding: 0.15em 0.6em;
    border: 2px solid var(--blood);
    color: var(--blood);
    transform: rotate(-3deg);
  }
</style>
