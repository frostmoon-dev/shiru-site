---
import { Picture } from 'astro:assets';
import type { CaseFile } from '../content/site';
import { casePhotos } from '../content/photos';

interface Props {
  file: CaseFile;
  index: number;
}
const { file, index } = Astro.props;
const photo = casePhotos[file.photo];
---

<li class="polaroid-wrap" style={`--rot:${file.rotation}deg; --i:${index}`}>
  <slot name="behind" />
  <a class="polaroid" href={`/archives/${file.slug}/`}>
    <span class="polaroid__photo" transition:name={`case-photo-${file.slug}`}>
      <Picture
        src={photo}
        alt={file.photoAlt}
        formats={['avif', 'webp']}
        widths={[280, 420, 560]}
        sizes="(max-width: 719px) 70vw, 280px"
        loading="lazy"
        decoding="async"
      />
    </span>
    <span class="polaroid__title" transition:name={`case-title-${file.slug}`}>{file.title}</span>
  </a>
  <slot name="front" />
</li>

<style>
  .polaroid-wrap {
    position: relative;
    list-style: none;
  }
  .polaroid {
    position: relative;
    display: block;
    width: 100%;
    padding: 6% 6% 4%;
    background: #f4f1ea;
    color: var(--ink);
    text-decoration: none;
    transform: rotate(var(--rot));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      6px 10px 18px rgb(42 26 18 / 0.28);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .polaroid:hover,
  .polaroid:focus-visible {
    transform: rotate(calc(var(--rot) * 0.4)) translateY(-8px) scale(1.03);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      12px 20px 26px rgb(42 26 18 / 0.32);
  }
  .polaroid:active {
    transform: rotate(0deg) scale(0.99);
  }
  .polaroid:focus-visible {
    outline-color: var(--ink);
  }
  .polaroid__photo {
    display: block;
    aspect-ratio: 1.2;
    overflow: hidden;
    background: var(--leather);
  }
  .polaroid__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.2);
    transition: filter var(--dur-slow) var(--ease-out);
  }
  .polaroid:hover .polaroid__photo :global(img) {
    filter: sepia(0) brightness(1.05);
  }
  .polaroid__title {
    display: block;
    margin-top: 5%;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.9rem + 0.7vw, 1.65rem);
    line-height: 1;
    color: var(--ink);
  }
</style>
