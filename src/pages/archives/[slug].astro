---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CloseFile from '../../components/CloseFile.astro';
import { caseFiles, type CaseFile } from '../../content/site';
import { casePhotos } from '../../content/photos';

export const getStaticPaths = (() => caseFiles.files.map((file) => ({ params: { slug: file.slug }, props: { file } }))) satisfies GetStaticPaths;

interface Props {
  file: CaseFile;
}
const { file } = Astro.props;
const idx = caseFiles.files.findIndex((f) => f.slug === file.slug);
const next = caseFiles.files[(idx + 1) % caseFiles.files.length]!;
---

<Base title={file.title} description={file.summary}>
  <article class="section file" data-tone="void" aria-labelledby="file-title">
    <CloseFile href="/#archives" label={caseFiles.closeLabel} flag="shiru:from-board" />
    <div class="container">
      <header class="section-head">
        <p class="kicker">Case No. II · File {file.number}</p>
        <h1 id="file-title" class="display-2" transition:name={`case-title-${file.slug}`}>{file.title}</h1>
        <p class="lead">{file.summary}</p>
      </header>

      <div class="file__grid">
        <figure class="file__photo" transition:name={`case-photo-${file.slug}`}>
          <Picture src={casePhotos[file.photo]} alt={file.photoAlt} formats={['avif', 'webp']} widths={[360, 560, 840]} sizes="(max-width: 959px) 90vw, 420px" loading="eager" fetchpriority="high" />
        </figure>

        <div class="file__text">
          <dl class="facts">
            {
              file.details.map((d) => (
                <div class="facts__row">
                  <dt>{d.heading}</dt>
                  <dd>{d.body}</dd>
                </div>
              ))
            }
            <div class="facts__row">
              <dt>{caseFiles.evidenceLabel}</dt>
              <dd>
                <ul class="file__tags">
                  {file.evidence.map((e) => <li>{e}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
          {
            file.link && (
              <p class="file__link">
                <a href={file.link.href} rel="noopener">
                  {file.link.label}
                </a>
              </p>
            )
          }
          <p class="file__next">
            <a href={`/archives/${next.slug}/`}>
              <span class="kicker">Next file</span>
              <span class="ahs file__next-title">{next.title}</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .file {
    min-height: 100svh;
    padding-top: calc(var(--section-pad) + var(--space-6));
  }
  .file__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .file__photo {
    margin: 0;
    padding: var(--space-2) var(--space-2) var(--space-6);
    background: var(--bone);
    rotate: -1.5deg;
    justify-self: start;
    width: min(100%, 26rem);
  }
  .file__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .file__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }
  .file__tags li {
    padding: var(--space-half) var(--space-1);
    border: 1px solid var(--line);
    font-size: var(--text-small);
  }
  .file__link {
    margin-top: var(--space-5);
  }
  .file__next {
    margin-top: var(--space-7);
  }
  .file__next a {
    display: inline-grid;
    gap: var(--space-1);
    color: var(--bone);
    text-decoration: none;
  }
  .file__next-title {
    font-size: var(--step-3);
    line-height: 1;
  }
  .file__next a:hover .file__next-title {
    color: var(--blood-lit);
  }
  @media (min-width: 960px) {
    .file__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
</style>
