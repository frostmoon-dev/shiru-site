---
// The personal page, or (PUBLIC_SITE_MODE=work) the work page. The env check is replaced at build
// time, so the branch not taken, and everything it would import, is left out of the build entirely.
const Page =
  import.meta.env.PUBLIC_SITE_MODE === 'work'
    ? (await import('../components/WorkPage.astro')).default
    : (await import('../components/HomePage.astro')).default;
---

<Page />
