---
import Base from '../layouts/Base.astro';
import BackwardsClock from '../components/props/BackwardsClock.astro';
import { notFound } from '../content/site';
---

<Base title={notFound.title} description={notFound.body} noindex>
  <section class="lost" data-tone="night" aria-labelledby="lost-title">
    <div class="lost__clock" aria-hidden="true"><BackwardsClock size={160} speed={3} /></div>
    <p class="label lost__label">{notFound.label}</p>
    <h1 id="lost-title" class="lost__title" data-effect="ghost-title">{notFound.title}</h1>
    <p class="flavour lost__body">{notFound.body}</p>
    <p><a class="btn" href="/">{notFound.back}</a></p>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-8) var(--gutter);
    max-width: 60rem;
    margin-inline: auto;
  }
  .lost__clock {
    transform: rotate(-12deg);
    margin-bottom: var(--space-3);
  }
  .lost__label {
    color: var(--muted);
  }
  .lost__title {
    font-size: var(--step-5);
    color: var(--bone);
    max-width: 16ch;
    margin-bottom: var(--space-4);
  }
  .lost__body {
    max-width: 34ch;
  }
</style>
