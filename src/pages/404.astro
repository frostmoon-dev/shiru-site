---
import { ahs } from '../lib/ahs';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { design } from '../content/photos';
import { notFound } from '../content/site';
---

<Base title={notFound.title} description={notFound.body} noindex>
  <section class="section lost" data-tone="void" aria-labelledby="lost-title">
    <div class="container lost__grid">
      <header class="section-head">
        <p class="kicker">Case No. ? · Missing</p>
        <h1 id="lost-title" class="display-2" data-effect="ghost-title">{ahs(notFound.title)}</h1>
        <p class="lead">{notFound.body}</p>
        <p><a class="btn" href="/">{notFound.back}</a></p>
      </header>
      <div class="lost__watch" aria-hidden="true"><Image src={design.pocketWatch} alt="" width={320} loading="eager" decoding="async" /></div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-items: center;
  }
  .lost__grid {
    display: grid;
    gap: var(--space-6);
  }
  .lost__grid::before {
    grid-column: 1 / -1;
  }
  .lost__watch {
    justify-self: center;
    width: clamp(120px, 16vw, 220px);
    transform-origin: 62% 0;
    animation: watch-swing 4.8s var(--ease-ink) infinite;
  }
  .lost__watch :global(img) {
    width: 100%;
    height: auto;
  }
  /* the watch hangs from its chain and swings, slowly */
  @keyframes watch-swing {
    0%,
    100% {
      rotate: -7deg;
    }
    50% {
      rotate: 6deg;
    }
  }
  @media (min-width: 960px) {
    .lost__grid {
      grid-template-columns: 8fr 4fr;
      align-items: center;
    }
  }
</style>
