---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { design } from '../content/photos';
import { notFound } from '../content/site';
---

<Base title={notFound.title} description={notFound.body} noindex>
  <section class="lost" data-tone="night" aria-labelledby="lost-title">
    <div class="lost__clock" aria-hidden="true"><Image src={design.pocketWatch} alt="" width={240} loading="eager" decoding="async" /></div>
    <p class="label lost__label">{notFound.label}</p>
    <h1 id="lost-title" class="lost__title" data-effect="ghost-title">{notFound.title}</h1>
    <p class="flavour lost__body">{notFound.body}</p>
    <p><a class="btn" href="/">{notFound.back}</a></p>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-8) var(--gutter);
    max-width: 60rem;
    margin-inline: auto;
  }
  .lost__clock {
    width: clamp(110px, 12vw, 170px);
    margin-bottom: var(--space-3);
    transform-origin: 62% 0;
    animation: watch-swing 4.8s var(--ease-ink) infinite;
  }
  .lost__clock :global(img) {
    width: 100%;
    height: auto;
  }
  /* the watch hangs from its chain and swings, slowly, the wrong way round */
  @keyframes watch-swing {
    0%,
    100% {
      rotate: -7deg;
    }
    50% {
      rotate: 6deg;
    }
  }
  .lost__label {
    color: var(--muted);
  }
  .lost__title {
    font-size: var(--step-5);
    color: var(--bone);
    max-width: 16ch;
    margin-bottom: var(--space-4);
  }
  .lost__body {
    max-width: 34ch;
  }
</style>
