---
import { ahs } from '../../lib/ahs';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CloseFile from '../../components/CloseFile.astro';
import { chapters, grimoire, type GrimoireEntry } from '../../content/site';

export const getStaticPaths = (() =>
  grimoire.entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))) satisfies GetStaticPaths;

interface Props {
  entry: GrimoireEntry;
}
const chapterNo = chapters.find((c) => c.id === 'grimoire')!.numeral;
const { entry } = Astro.props;
const i = grimoire.entries.findIndex((e) => e.slug === entry.slug);
const prev = grimoire.entries[i - 1];
const next = grimoire.entries[i + 1];
---

<Base title={entry.title} description={entry.excerpt}>
  <article class="section entry" data-tone="void" aria-labelledby="entry-title">
    <CloseFile href="/#grimoire" label="Back to the grimoire" flag="shiru:from-grimoire" />
    <div class="container">
      <header class="section-head">
        <p class="kicker">Case No. {chapterNo} · Chapter {entry.numeral} · {entry.date ? <time datetime={entry.date}>{entry.when}</time> : entry.when}</p>
        <h1 id="entry-title" class="display-2" data-effect="ghost-title">{ahs(entry.title)}</h1>
        <p class="lead">{entry.excerpt}</p>
      </header>
      <div class="body-copy entry__body">
        {entry.body.map((p) => <p>{p}</p>)}
      </div>
      <nav class="entry__nav" aria-label="More chapters">
        {
          prev ? (
            <a href={`/grimoire/${prev.slug}/`}>
              <span class="kicker">← Previous</span>
              <span class="entry__nav-title">{prev.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/grimoire/${next.slug}/`} class="entry__nav-next">
              <span class="kicker">Next →</span>
              <span class="entry__nav-title">{next.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .entry {
    min-height: 100svh;
    padding-top: calc(var(--section-pad) + var(--space-6));
  }
  .entry__nav {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .entry__nav a {
    display: inline-grid;
    gap: var(--space-1);
    min-height: var(--touch);
    color: var(--bone);
    text-decoration: none;
  }
  .entry__nav-next {
    text-align: right;
    margin-left: auto;
  }
  .entry__nav-title {
    font-size: var(--lead);
  }
  .entry__nav a:hover .entry__nav-title {
    text-decoration: underline;
    text-decoration-color: var(--blood);
    text-underline-offset: 0.25em;
  }
</style>
