---
import { getImage } from 'astro:assets';
import { intro } from '../content/site';
import { collage, cutouts } from '../content/photos';

// Small, fixed renditions: the intro is the first thing painted, so it must be light.
const butterfly = await getImage({ src: collage.moth, width: 520, format: 'webp', quality: 78 });
const roses = await getImage({ src: cutouts.roses, width: 640, format: 'webp', quality: 76 });
---

<!--
  The intro: roses open in two corners of the page, a butterfly flutters in along a curve,
  settles in the middle with a few slow beats of its wings, then lifts away as the page opens.
-->
<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="Intro" data-effect="intro" data-effect-eager data-effect-priority="high">
  <img class="intro__roses intro__roses--a" src={roses.src} alt="" width="640" height="357" decoding="async" fetchpriority="high" />
  <img class="intro__roses intro__roses--b" src={roses.src} alt="" width="640" height="357" decoding="async" fetchpriority="high" />
  <div class="intro__fly" aria-hidden="true">
    <img class="intro__wings" src={butterfly.src} alt="" width="520" height="333" decoding="async" fetchpriority="high" />
  </div>
  <p class="intro__status label" aria-live="polite"><span>{intro.label}</span></p>
  <button class="btn intro__skip" type="button" data-intro-skip>{intro.skip}</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: none;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 45%, rgb(255 255 255 / 0.55), transparent 60%),
      var(--parchment);
    color: var(--cocoa);
  }
  :global(html.intro-pending) .intro {
    display: grid;
  }
  :global(html.intro-pending) {
    overflow: hidden;
  }
  .intro__roses {
    position: absolute;
    width: clamp(220px, 34vw, 480px);
    height: auto;
    filter: drop-shadow(0 10px 14px rgb(57 49 47 / 0.18));
    pointer-events: none;
  }
  .intro__roses--a {
    left: -4%;
    bottom: -6%;
    transform-origin: 30% 80%;
  }
  .intro__roses--b {
    right: -4%;
    top: -6%;
    /* turned upside down around its own centre, so it stays tucked into the corner */
    rotate: 180deg;
    transform-origin: 50% 50%;
  }
  .intro__fly {
    width: clamp(160px, 30vmin, 300px);
    /* lit from above, like something pinned in a case that has just remembered it can fly */
    filter: drop-shadow(0 18px 16px rgb(57 49 47 / 0.22));
    will-change: transform;
  }
  .intro__wings {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  /* top left: the one corner without roses */
  .intro__status {
    position: absolute;
    left: var(--gutter);
    top: var(--space-4);
    color: var(--muted);
  }
  .intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-3);
    color: var(--cocoa);
  }
  @media (max-width: 719px) {
    .intro__roses {
      width: 52vw;
    }
    .intro__roses--b {
      right: -12%;
    }
    .intro__status {
      max-width: 15ch;
    }
  }
</style>
