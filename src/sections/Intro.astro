---
import { getImage } from 'astro:assets';
import { intro } from '../content/site';
import moonDisc from '../assets/collage/moon.png';

const moon = await getImage({ src: moonDisc, width: 300, format: 'webp', quality: 75 });
---

<!--
  The glasshouse at dusk: a gothic arched window is drawn line by line in olive ink, the moon
  rises inside it through the dusk, leaves climb from the sill, and the page opens onto the hero.
-->
<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="Intro" data-effect="intro" data-effect-eager data-effect-priority="high">
  <svg class="intro__window" viewBox="0 0 300 440" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="intro-dusk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4b4c39" />
        <stop offset="0.55" stop-color="#6c6e51" />
        <stop offset="1" stop-color="#c9c8a1" />
      </linearGradient>
      <clipPath id="intro-pane">
        <path d="M48 410 V176 Q48 52 150 34 Q252 52 252 176 V410 Z" />
      </clipPath>
    </defs>
    <!-- the dusk through the glass, and the moon rising in it -->
    <g clip-path="url(#intro-pane)">
      <rect class="intro__dusk" x="40" y="20" width="220" height="400" fill="url(#intro-dusk)" />
      <image class="intro__moon" href={moon.src} x="102" y="120" width="96" height="96" />
    </g>
    <!-- the frame, drawn in ink: arch, inner arch, two lancets, the rose, mullion, transom, sill -->
    <g class="intro__ink" fill="none" stroke="#585a40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M30 412 V170 Q30 30 150 12 Q270 30 270 170 V412" stroke-width="2.4" />
      <path d="M48 410 V176 Q48 52 150 34 Q252 52 252 176 V410" stroke-width="1.4" />
      <path d="M150 34 V410" stroke-width="1.2" />
      <path d="M48 250 H252" stroke-width="1.2" />
      <path d="M58 250 V170 Q58 110 104 92 Q140 110 142 170 V250" stroke-width="1" />
      <path d="M158 250 V170 Q160 110 196 92 Q242 110 242 170 V250" stroke-width="1" />
      <circle cx="150" cy="104" r="22" stroke-width="1" />
      <path d="M14 414 H286" stroke-width="2.4" />
    </g>
    <!-- leaves and a lily climbing from the sill -->
    <g class="intro__leaves" fill="none" stroke="#6c6e51" stroke-width="1.4" stroke-linecap="round">
      <path d="M40 412 C 44 380 36 352 52 324" />
      <path d="M52 324 C 64 330 70 344 60 356 C 50 352 46 338 52 324 Z" />
      <path d="M44 372 C 30 364 24 352 28 340 C 40 344 46 356 44 372 Z" />
      <path d="M262 412 C 258 372 268 340 252 300" />
      <path d="M252 300 C 246 292 248 280 256 276 M252 300 C 258 290 266 286 272 290 M252 300 C 252 288 244 282 238 284" />
      <path d="M260 360 C 274 352 282 340 278 328 C 266 332 258 346 260 360 Z" />
    </g>
  </svg>
  <p class="intro__status label" aria-live="polite"><span>{intro.moonLabel}</span></p>
  <button class="btn intro__skip" type="button" data-intro-skip>{intro.skip}</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: none;
    place-items: center;
    background:
      radial-gradient(ellipse at 50% 45%, rgb(255 255 255 / 0.5), transparent 60%),
      var(--parchment);
    color: var(--cocoa);
  }
  :global(html.intro-pending) .intro {
    display: grid;
  }
  :global(html.intro-pending) {
    overflow: hidden;
  }
  .intro__window {
    width: min(58vmin, 340px);
    height: auto;
    overflow: visible;
  }
  .intro__status {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-4);
    color: var(--muted);
  }
  .intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-3);
    color: var(--cocoa);
  }
</style>
