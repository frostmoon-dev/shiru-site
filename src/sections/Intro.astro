---
import { getImage } from 'astro:assets';
import { intro } from '../content/site';
import { introPhotos } from '../content/photos';
import moonPoster from '../assets/collage/moon-poster.jpg';

// Frames are drawn on a <canvas> (not <img>) so a 50 ms flash never becomes the page's LCP element.
const frameUrls = await Promise.all(
  intro.frames.map(async (f) => (await getImage({ src: introPhotos[f.src as keyof typeof introPhotos], width: 420, format: 'webp', quality: 60 })).src),
);
const poster = await getImage({ src: moonPoster, width: 960, format: 'webp', quality: 55 });
---

<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="Intro" data-effect="intro" data-effect-eager data-effect-priority="high">
  <!-- The moon through the branches (Teha's footage), muted, played from mid-rise. -->
  <video class="intro__moon" muted playsinline preload="auto" poster={poster.src} aria-hidden="true" tabindex="-1" disablepictureinpicture>
    <source src="/media/moon.mp4" type="video/mp4" />
  </video>
  <div class="intro__glow" aria-hidden="true"></div>
  <canvas class="intro__static" width="320" height="180" aria-hidden="true"></canvas>
  <canvas class="intro__frames" width="420" height="525" aria-hidden="true" data-frames={JSON.stringify(frameUrls)}></canvas>
  <p class="intro__status label" aria-live="polite"><span>{intro.moonLabel}</span> <span data-intro-progress></span></p>
  <button class="btn intro__skip" type="button" data-intro-skip>{intro.skip}</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: none;
    place-items: center;
    background: var(--void);
    color: var(--bone);
  }
  :global(html.intro-pending) .intro {
    display: grid;
  }
  :global(html.intro-pending) {
    overflow: hidden;
  }
  .intro__moon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* nudged so the moon sits a little above the centre, where the photos burst */
    object-position: 50% 62%;
    transform-origin: 52% 48%;
    animation: moon-drift 3s linear both;
  }
  @keyframes moon-drift {
    from {
      scale: 1.12;
    }
    to {
      scale: 1.22;
    }
  }
  /* cold moonlight bleeding into the dark */
  .intro__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 52% 46%, rgb(214 222 205 / 0.08), transparent 55%);
  }
  @media (prefers-reduced-motion: reduce) {
    .intro__moon {
      animation: none;
      scale: 1.12;
    }
  }
  .intro__frames {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(62vmin, 420px);
    aspect-ratio: 4 / 5;
    translate: -50% -50%;
    visibility: hidden;
    pointer-events: none;
    /* luminance-matched: every frame toned to the same dark sepia, so cuts don't strobe */
    filter: sepia(1) brightness(0.55) contrast(1.1);
  }
  /* AHS-style TV static: dim snow with a rolling bar, only in short bursts */
  .intro__static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .intro__status {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-4);
    color: var(--muted);
  }
  .intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-3);
    color: var(--bone);
  }
</style>
