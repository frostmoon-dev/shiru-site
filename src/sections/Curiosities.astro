---
import { Image } from 'astro:assets';
import { chapters, curiosities, ui, type Curiosity } from '../content/site';
import { cutouts } from '../content/photos';
import SectionHead from '../components/SectionHead.astro';

const ch = chapters.find((c) => c.id === 'curiosities')!;

// Line drawings for the card faces (64 × 64, stroked in bone).
const GLYPHS: Record<string, string> = {
  cat: 'M16 52c-2-14 4-26 16-26s18 12 16 26z M18 33 14 15l11 9 M46 33l4-18-11 9 M29 44h6l-3 3z M22 46l-8 1 M42 46l8 1',
  cup: 'M19 18h26l-3 38H22z M36 18l7-11 M23 28h18 M26 33h6v6h-6z M33 40h6v6h-6z',
  moon: 'M42 10a22 22 0 1 0 0 44 17 17 0 1 1 0-44z M50 18l1.5 3 3 1.5-3 1.5-1.5 3-1.5-3-3-1.5 3-1.5z',
  mask: 'M13 17c13-5 25-5 38 0 0 19-7 31-19 31S13 36 13 17z M21 28c3-3 7-3 9 0 M34 28c3-3 7-3 9 0 M26 39c4 3 8 3 12 0',
  quill: 'M48 9C33 13 22 27 18 47 M48 9c-2 13-11 21-25 25 M15 56l4-9',
  tongues: 'M9 13h27v17H20l-7 7v-7H9z M28 35h27v17h-4v7l-7-7H28z M15 20h14 M15 24h9 M34 42h14 M34 46h9',
  key: 'M20 15a8 8 0 1 0 0 16 8 8 0 1 0 0-16z M26 29l23 23 M41 44l5-5 M46 49l5-5',
  music: 'M24 47V16l23-7v31 M24 23l23-7 M19 42a5 5 0 1 0 0 10 5 5 0 1 0 0-10z M42 35a5 5 0 1 0 0 10 5 5 0 1 0 0-10z',
  rose: 'M32 30c-6 0-10-4-10-9s5-9 10-9 10 4 10 9-4 9-10 9z M27 21c3-4 7-4 10 0 M32 30v26 M32 43c-6-3-11-1-13 4 M32 48c5-4 10-3 12 1',
};
---

<!--
  The herbarium: the hobbies are specimen cards, each one mounted with two strips of tape and a
  numbered label, laid out on graph paper with roses in the corners. Turn one over to read it.
-->
<section id={ch.id} class="section deck herbarium" data-tone="void" aria-labelledby="curiosities-title">
  <div class="herbarium__scene" aria-hidden="true">
    <Image class="herbarium__roses herbarium__roses--left" src={cutouts.roses} alt="" widths={[320, 640]} sizes="22vw" loading="lazy" decoding="async" />
    <Image class="herbarium__roses herbarium__roses--right" src={cutouts.roses} alt="" widths={[320, 640]} sizes="22vw" loading="lazy" decoding="async" />
  </div>
  <div class="container">
    <SectionHead id="curiosities-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={curiosities.title} lead={curiosities.lead} />

    <ul class="deck__cards" data-effect="deal">
      {
        (curiosities.cards as Curiosity[]).map((c) => (
          <li class="tarot" data-tarot>
            <div class="tarot__inner">
              {/* the face: numeral, a drawing, the name. The whole face is the button that turns it. */}
              <div class="tarot__face tarot__front" data-front>
                <span class="tarot__label" aria-hidden="true">
                  Specimen <span class="tarot__no">No. {c.numeral}</span>
                </span>
                {c.image ? (
                  <span class="tarot__mount">
                    <Image class="tarot__art" src={cutouts[c.image]} alt="" widths={[240, 480]} sizes="(max-width: 599px) 50vw, 16rem" loading="lazy" decoding="async" />
                    <span class="tarot__tape tarot__tape--a" aria-hidden="true" />
                    <span class="tarot__tape tarot__tape--b" aria-hidden="true" />
                  </span>
                ) : (
                  <svg class="tarot__glyph" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <path d={GLYPHS[c.glyph]} />
                  </svg>
                )}
                <h3 class="tarot__title">{c.title}</h3>
                <button class="tarot__turn" type="button" aria-expanded="false" aria-controls={`card-${c.id}`} data-turn>
                  <span class="visually-hidden">
                    {curiosities.turn}: {c.title}
                  </span>
                </button>
              </div>
              {/* the back: what it's about */}
              <div class="tarot__face tarot__back" id={`card-${c.id}`} data-back>
                <p class="tarot__back-title" aria-hidden="true">
                  No. {c.numeral} · {c.title}
                </p>
                <p class="tarot__body">{c.body}</p>
                {c.items && (
                  <ul class="tarot__items">
                    {c.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                )}
                {c.links && (
                  <p class="tarot__links">
                    {c.links.map((l) => (
                      <a href={l.href} rel="me noopener" target="_blank">
                        {l.label} <span aria-hidden="true">↗</span>
                        <span class="visually-hidden"> (opens in a new tab)</span>
                      </a>
                    ))}
                  </p>
                )}
                {c.playsMusic && (
                  <button class="btn tarot__music" type="button" data-music aria-pressed="false" data-play={curiosities.play} data-pause={curiosities.pause}>
                    <span data-music-label>{curiosities.play}</span>
                  </button>
                )}
                <button class="tarot__back-btn" type="button" data-turn-back>
                  {curiosities.turnBack} <span aria-hidden="true">↺</span>
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ================= the herbarium ================= */
  .herbarium {
    isolation: isolate;
    overflow: hidden;
    /* faint graph paper, like a botanist's notebook */
    background:
      linear-gradient(rgb(108 110 81 / 0.07) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgb(108 110 81 / 0.07) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(#efe7da, #e9e0cf);
  }
  .herbarium > .container {
    position: relative;
    z-index: 2;
  }
  .herbarium__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .herbarium :global(.herbarium__roses) {
    position: absolute;
    top: 3%;
    width: clamp(150px, 20vw, 320px);
    height: auto;
    opacity: 0.9;
    filter: drop-shadow(0 8px 12px rgb(57 49 47 / 0.15));
    animation: roses-sway 9s ease-in-out infinite alternate;
  }
  .herbarium :global(.herbarium__roses--left) {
    left: -3%;
    rotate: -8deg;
  }
  .herbarium :global(.herbarium__roses--right) {
    right: -3%;
    scale: -1 1;
    rotate: 8deg;
    animation-delay: -4s;
  }
  @keyframes roses-sway {
    to {
      translate: 0 6px;
    }
  }

  /* ================= the cards ================= */
  .deck__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    /* top margin comes from .section-head + * (the shared rhythm) */
    margin-inline: 0;
    margin-bottom: 0;
  }
  .tarot {
    perspective: 1400px;
    /* the card's own width, so the words on its back can size themselves to it */
    container-type: inline-size;
  }
  /* every card is exactly 5:7, whatever is mounted on it: the faces are laid over the card */
  .tarot__inner {
    position: relative;
    display: block;
    aspect-ratio: 5 / 7;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.8s var(--ease-ink);
  }
  .tarot.is-tilting .tarot__inner {
    transition: transform 0.12s linear;
  }
  .tarot.is-turned .tarot__inner {
    transform: rotateY(180deg);
  }
  .tarot__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    backface-visibility: hidden;
    border-radius: 4px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 16px 28px rgb(57 49 47 / 0.16);
  }

  /* the face: a mounted specimen on card stock, inside an olive double rule */
  .tarot__front {
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 12% 10% 11%;
    text-align: center;
    color: var(--cocoa);
    background: var(--card);
    border: 1px solid rgb(108 110 81 / 0.55);
    outline: 1px solid rgb(108 110 81 / 0.3);
    outline-offset: -8px;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .tarot__label {
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tarot__no {
    color: var(--olive-dk);
  }
  /* the specimen, held on by two strips of sage tape */
  .tarot__mount {
    position: relative;
    display: grid;
    place-items: center;
    width: 70%;
    flex: 1;
    min-height: 0;
  }
  .tarot__front :global(.tarot__art) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 6px rgb(57 49 47 / 0.22));
  }
  .tarot__tape {
    position: absolute;
    width: 34%;
    height: 11%;
    background: rgb(186 188 156 / 0.62);
    box-shadow: 0 1px 1px rgb(57 49 47 / 0.08);
    mix-blend-mode: multiply;
  }
  .tarot__tape--a {
    top: 6%;
    left: -2%;
    rotate: -24deg;
  }
  .tarot__tape--b {
    bottom: 6%;
    right: -2%;
    rotate: -24deg;
  }
  .tarot__glyph {
    width: 44%;
    fill: none;
    stroke: var(--olive);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tarot__title {
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--cocoa);
    text-wrap: balance;
  }
  /* the whole face turns the card */
  .tarot__turn {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
  }
  .tarot__turn:focus-visible {
    outline: 2px solid var(--olive-dk);
    outline-offset: 4px;
    box-shadow: none;
  }
  .tarot:not(.is-turned):hover .tarot__front {
    border-color: var(--olive);
  }

  /* the back: sage card with a thin gold double frame, the words in cocoa ink */
  .tarot__back {
    transform: rotateY(180deg);
    gap: 0.6em;
    padding: 16% 13% 14%;
    overflow: hidden;
    color: var(--cocoa);
    background: var(--sage);
    border: 1px solid var(--gold);
    outline: 1px solid rgb(168 138 74 / 0.7);
    outline-offset: -9px;
    font-size: clamp(0.78rem, 4.6cqi, 1rem);
  }
  /* a little gold flourish in each corner */
  .tarot__back::before,
  .tarot__back::after {
    content: '❦';
    position: absolute;
    font-size: 0.9em;
    line-height: 1;
    color: var(--gold-dk);
  }
  .tarot__back::before {
    top: 16px;
    left: 16px;
  }
  .tarot__back::after {
    right: 16px;
    bottom: 16px;
    rotate: 180deg;
  }
  .tarot__back-title {
    font-weight: 700;
    font-size: 0.72em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3f4130;
  }
  .tarot__body {
    color: var(--cocoa);
    line-height: 1.55;
  }
  .tarot__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tarot__items li {
    padding: 0.2em 0.5em;
    border: 1px solid rgb(57 49 47 / 0.35);
    font-size: 0.82em;
    color: var(--cocoa);
  }
  .tarot__links a {
    color: var(--cocoa);
  }
  .tarot__music {
    align-self: flex-start;
    padding: 0.5em 1em;
    font-size: 0.72em;
    color: var(--cocoa);
    border-color: var(--cocoa);
  }
  .tarot__music[aria-pressed='true'] {
    color: var(--parchment);
    background: var(--cocoa);
  }
  .tarot__back-btn {
    margin-top: auto;
    align-self: flex-start;
    min-height: var(--touch);
    padding: 0;
    border: 0;
    background: transparent;
    font-weight: 700;
    font-size: 0.72em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3f4130;
    cursor: pointer;
  }
  .tarot__back-btn:hover {
    color: var(--cocoa);
    text-decoration: underline;
  }
  .tarot__back-btn:focus-visible {
    outline: 2px solid var(--cocoa);
  }

  /* very small cards (the smallest phones): a little less air, so the longest words still fit */
  @container (max-width: 250px) {
    .tarot__back {
      padding: 15% 12% 13%;
      gap: 0.45em;
      font-size: 0.74rem;
    }
    .tarot__body {
      line-height: 1.45;
    }
  }

  /* without JS every card shows its words, and nothing pretends to turn */
  :global(html:not(.js)) .tarot__inner {
    transform: none;
    aspect-ratio: auto;
  }
  :global(html:not(.js)) .tarot__front {
    display: none;
  }
  :global(html:not(.js)) .tarot__back {
    position: relative;
    transform: none;
    min-height: 100%;
  }
  :global(html:not(.js)) .tarot__back-btn {
    display: none;
  }

  @media (max-width: 959px) {
    .deck__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* phones: a hand of cards to swipe through */
  @media (max-width: 599px) {
    .deck__cards {
      display: flex;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      padding: var(--space-3) 14vw var(--space-4);
      margin-inline: calc(var(--gutter) * -1);
      scrollbar-width: none;
    }
    .tarot {
      flex: 0 0 72vw;
      scroll-snap-align: center;
    }
    .herbarium :global(.herbarium__roses) {
      width: 34vw;
      top: 1%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tarot__inner {
      transition: none;
    }
    .herbarium :global(.herbarium__roses) {
      animation: none;
    }
  }
</style>

<script>
  import { sfx } from '../lib/sfx';

  function setup() {
    document.querySelectorAll<HTMLElement>('[data-tarot]').forEach((card) => {
      const turn = card.querySelector<HTMLButtonElement>('[data-turn]');
      const back = card.querySelector<HTMLElement>('[data-back]');
      const front = card.querySelector<HTMLElement>('[data-front]');
      const backBtn = card.querySelector<HTMLButtonElement>('[data-turn-back]');
      if (!turn || !back || !front || !backBtn) return;
      // the hidden side can't be reached: its links and buttons stay out of the tab order
      back.inert = true;
      const set = (turned: boolean) => {
        card.classList.toggle('is-turned', turned);
        turn.setAttribute('aria-expanded', String(turned));
        back.inert = !turned;
        front.inert = turned;
        sfx('card');
        // move focus with the card, after it has turned far enough to see
        window.setTimeout(() => (turned ? backBtn : turn).focus({ preventScroll: true }), 120);
      };
      turn.onclick = () => set(true);
      backBtn.onclick = () => set(false);
      card.onkeydown = (e) => {
        if (e.key === 'Escape' && card.classList.contains('is-turned')) set(false);
      };
    });

    // the music card plays the site's music: it presses the same switch as the speaker in the top bar
    const toggle = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const music = document.querySelector<HTMLButtonElement>('[data-music]');
    const label = music?.querySelector<HTMLElement>('[data-music-label]');
    if (!toggle || !music || !label) return;
    const sync = () => {
      const on = toggle.getAttribute('aria-pressed') === 'true';
      music.setAttribute('aria-pressed', String(on));
      label.textContent = on ? (music.dataset.pause ?? '') : (music.dataset.play ?? '');
    };
    music.onclick = () => toggle.click();
    new MutationObserver(sync).observe(toggle, { attributes: true, attributeFilter: ['aria-pressed'] });
    sync();
  }
  // Cards lean toward the pointer (mouse only, not while turned, not under reduced motion).
  function setupTilt() {
    const deck = document.querySelector<HTMLElement>('.herbarium');
    if (!deck) return;
    if (!window.matchMedia('(pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    deck.querySelectorAll<HTMLElement>('[data-tarot]').forEach((card) => {
      const inner = card.querySelector<HTMLElement>('.tarot__inner');
      if (!inner) return;
      card.addEventListener('pointermove', (e) => {
        if (card.classList.contains('is-turned')) return;
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.classList.add('is-tilting');
        inner.style.setProperty('--tilt-y', `${(x * 14).toFixed(2)}deg`);
        inner.style.setProperty('--tilt-x', `${(-y * 12).toFixed(2)}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-tilting');
        inner.style.removeProperty('--tilt-x');
        inner.style.removeProperty('--tilt-y');
      });
    });
  }
  document.addEventListener('astro:page-load', () => {
    setup();
    setupTilt();
  });
</script>
