---
import { Image, getImage } from 'astro:assets';
import { chapters, curiosities, ui, type Curiosity } from '../content/site';
import { cutouts } from '../content/photos';
import SectionHead from '../components/SectionHead.astro';
import { ahs } from '../lib/ahs';

const ch = chapters.find((c) => c.id === 'curiosities')!;

// Line drawings for the card faces (64 × 64, stroked in bone).
const GLYPHS: Record<string, string> = {
  cat: 'M16 52c-2-14 4-26 16-26s18 12 16 26z M18 33 14 15l11 9 M46 33l4-18-11 9 M29 44h6l-3 3z M22 46l-8 1 M42 46l8 1',
  cup: 'M19 18h26l-3 38H22z M36 18l7-11 M23 28h18 M26 33h6v6h-6z M33 40h6v6h-6z',
  moon: 'M42 10a22 22 0 1 0 0 44 17 17 0 1 1 0-44z M50 18l1.5 3 3 1.5-3 1.5-1.5 3-1.5-3-3-1.5 3-1.5z',
  mask: 'M13 17c13-5 25-5 38 0 0 19-7 31-19 31S13 36 13 17z M21 28c3-3 7-3 9 0 M34 28c3-3 7-3 9 0 M26 39c4 3 8 3 12 0',
  quill: 'M48 9C33 13 22 27 18 47 M48 9c-2 13-11 21-25 25 M15 56l4-9',
  tongues: 'M9 13h27v17H20l-7 7v-7H9z M28 35h27v17h-4v7l-7-7H28z M15 20h14 M15 24h9 M34 42h14 M34 46h9',
  key: 'M20 15a8 8 0 1 0 0 16 8 8 0 1 0 0-16z M26 29l23 23 M41 44l5-5 M46 49l5-5',
  music: 'M24 47V16l23-7v31 M24 23l23-7 M19 42a5 5 0 1 0 0 10 5 5 0 1 0 0-10z M42 35a5 5 0 1 0 0 10 5 5 0 1 0 0-10z',
  rose: 'M32 30c-6 0-10-4-10-9s5-9 10-9 10 4 10 9-4 9-10 9z M27 21c3-4 7-4 10 0 M32 30v26 M32 43c-6-3-11-1-13 4 M32 48c5-4 10-3 12 1',
};
const back = await getImage({ src: cutouts.cardBack, width: 800, format: 'webp', quality: 80 });
---

<!--
  Wonderland: the one light chapter. A checkered floor runs off into the distance, white roses
  get painted red as you scroll, a small bird hops across now and then, and the hobbies are a
  deck of playing cards the Queen deals out when you arrive.
-->
<section id={ch.id} class="section deck wonder" data-tone="paper" aria-labelledby="curiosities-title">
  <div class="wonder__scene" aria-hidden="true">
    <div class="wonder__floor"></div>
    <div class="wonder__roses wonder__roses--left" data-effect="paint-red">
      <Image class="wonder__rose" src={cutouts.roses} alt="" widths={[320, 640]} sizes="22vw" loading="lazy" decoding="async" />
      <Image class="wonder__rose wonder__rose--red" src={cutouts.roses} alt="" widths={[320, 640]} sizes="22vw" loading="lazy" decoding="async" />
    </div>
    <div class="wonder__roses wonder__roses--right" data-effect="paint-red">
      <Image class="wonder__rose" src={cutouts.roses} alt="" widths={[320, 640]} sizes="22vw" loading="lazy" decoding="async" />
      <Image class="wonder__rose wonder__rose--red" src={cutouts.roses} alt="" widths={[320, 640]} sizes="22vw" loading="lazy" decoding="async" />
    </div>
    <span class="wonder__bird"><Image src={cutouts.quail} alt="" width={160} loading="lazy" decoding="async" /></span>
  </div>
  <div class="container">
    <SectionHead id="curiosities-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={curiosities.title} lead={curiosities.lead} />

    <ul class="deck__cards" data-effect="deal" style={`--card-back:url(${back.src})`}>
      {
        (curiosities.cards as Curiosity[]).map((c) => (
          <li class="tarot" data-tarot>
            <div class="tarot__inner">
              {/* the face: numeral, a drawing, the name. The whole face is the button that turns it. */}
              <div class:list={['tarot__face tarot__front', (c.suit === '♥' || c.suit === '♦') && 'is-red']} data-front>
                <span class="tarot__index tarot__index--top" aria-hidden="true">
                  <span>{c.numeral}</span>
                  <span>{c.suit}</span>
                </span>
                <span class="tarot__index tarot__index--bottom" aria-hidden="true">
                  <span>{c.numeral}</span>
                  <span>{c.suit}</span>
                </span>
                {c.image ? (
                  <Image class="tarot__art" src={cutouts[c.image]} alt="" widths={[240, 480]} sizes="(max-width: 599px) 50vw, 16rem" loading="lazy" decoding="async" />
                ) : (
                  <svg class="tarot__glyph" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <path d={GLYPHS[c.glyph]} />
                  </svg>
                )}
                <h3 class="tarot__title">{ahs(c.title)}</h3>
                <button class="tarot__turn" type="button" aria-expanded="false" aria-controls={`card-${c.id}`} data-turn>
                  <span class="visually-hidden">
                    {curiosities.turn}: {c.title}
                  </span>
                </button>
              </div>
              {/* the back: what it's about */}
              <div class="tarot__face tarot__back" id={`card-${c.id}`} data-back>
                <p class="tarot__back-title" aria-hidden="true">
                  {c.numeral} {c.suit} · {c.title}
                </p>
                <p class="tarot__body">{c.body}</p>
                {c.items && (
                  <ul class="tarot__items">
                    {c.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                )}
                {c.links && (
                  <p class="tarot__links">
                    {c.links.map((l) => (
                      <a href={l.href} rel="me noopener" target="_blank">
                        {l.label} <span aria-hidden="true">↗</span>
                        <span class="visually-hidden"> (opens in a new tab)</span>
                      </a>
                    ))}
                  </p>
                )}
                {c.playsMusic && (
                  <button class="btn tarot__music" type="button" data-music aria-pressed="false" data-play={curiosities.play} data-pause={curiosities.pause}>
                    <span data-music-label>{curiosities.play}</span>
                  </button>
                )}
                <button class="tarot__back-btn" type="button" data-turn-back>
                  {curiosities.turnBack} <span aria-hidden="true">↺</span>
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ================= Wonderland ================= */
  .wonder {
    /* focus rings in red ink on the light paper */
    --focus: #a3141b;
    --ink: #1b1214;
    --card: #fbf7ee;
    --heart: #a3141b;
    isolation: isolate;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(ellipse at 50% 0%, rgb(255 255 255 / 0.65), transparent 60%),
      linear-gradient(#efe6d2, #e6dac0 70%, #d9cbab);
  }
  .wonder :global(.section-head .kicker) {
    color: var(--heart);
  }
  .wonder :global(.section-head .display-2) {
    color: var(--ink);
  }
  .wonder :global(.section-head .lead) {
    color: #3b2a22;
  }
  .wonder > .container::before {
    background: rgb(27 18 20 / 0.18);
  }
  .wonder > .container {
    position: relative;
    z-index: 2;
  }

  /* the scene behind the cards */
  .wonder__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* a checkered floor running off to the horizon */
  .wonder__floor {
    position: absolute;
    left: -30%;
    right: -30%;
    bottom: -8%;
    height: 62%;
    background: repeating-conic-gradient(#1b1214 0 25%, #f3ead6 0 50%) 0 0 / 96px 96px;
    transform: perspective(520px) rotateX(64deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 30%, transparent 92%);
    opacity: 0.85;
  }
  /* white roses, painted red as you scroll (the red copy is wiped on over the white one) */
  .wonder__roses {
    position: absolute;
    top: 6%;
    width: clamp(160px, 22vw, 340px);
    display: grid;
  }
  .wonder__roses--left {
    left: -3%;
    rotate: -8deg;
  }
  .wonder__roses--right {
    right: -3%;
    rotate: 172deg;
    scale: 1 -1;
  }
  .wonder__roses :global(.wonder__rose) {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
  }
  .wonder__roses :global(.wonder__rose--red) {
    filter: sepia(1) saturate(7) hue-rotate(-38deg) brightness(0.62) contrast(1.2);
    clip-path: inset(0 100% 0 0);
  }
  :global(html:not(.js)) .wonder__roses :global(.wonder__rose--red) {
    clip-path: none;
  }
  /* a small bird crosses the floor now and then */
  .wonder__bird {
    position: absolute;
    bottom: 6%;
    left: 0;
    width: clamp(56px, 6vw, 90px);
    translate: -140px 0;
  }
  .wonder__bird :global(img) {
    width: 100%;
    height: auto;
  }
  .wonder.is-live .wonder__bird {
    animation: bird-cross 16s linear infinite 3s;
  }
  .wonder.is-live .wonder__bird :global(img) {
    animation: bird-hop 0.5s steps(2, end) infinite;
  }
  @keyframes bird-cross {
    0% {
      translate: -140px 0;
    }
    45%,
    100% {
      translate: calc(100vw + 140px) 0;
    }
  }
  @keyframes bird-hop {
    50% {
      translate: 0 -6px;
    }
  }

  /* ================= the deck ================= */
  .deck__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    /* top margin comes from .section-head + * (the shared rhythm) */
    margin-inline: 0;
    margin-bottom: 0;
  }
  .tarot {
    perspective: 1400px;
    /* the card's own width, so the words on its back can size themselves to it */
    container-type: inline-size;
  }
  /* every card is exactly 5:7, whatever is drawn on it: the faces are laid over the card, not in it */
  .tarot__inner {
    position: relative;
    display: block;
    aspect-ratio: 5 / 7;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.8s var(--ease-ink);
  }
  .tarot.is-tilting .tarot__inner {
    transition: transform 0.12s linear;
  }
  .tarot.is-turned .tarot__inner {
    transform: rotateY(180deg);
  }
  .tarot__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    backface-visibility: hidden;
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 18px 30px rgb(43 26 18 / 0.28);
  }

  /* the face: a playing card */
  .tarot__front {
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    text-align: center;
    color: var(--ink);
    background: radial-gradient(ellipse at 50% 40%, #fffdf7, var(--card) 70%);
    border: 1px solid rgb(27 18 20 / 0.35);
    outline: 1px solid rgb(27 18 20 / 0.18);
    outline-offset: -8px;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .tarot__front.is-red {
    --suit: var(--heart);
  }
  .tarot__index {
    position: absolute;
    display: grid;
    justify-items: center;
    line-height: 1;
    font-family: var(--font-display);
    font-feature-settings: 'ss04' 1, 'liga' 0, 'dlig' 0;
    font-size: var(--step-1);
    color: var(--suit, var(--ink));
  }
  .tarot__index span:last-child {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95em;
  }
  /* the corner marks sit inside the inner border line (which is 8px in) */
  .tarot__index--top {
    top: 18px;
    left: 18px;
  }
  .tarot__index--bottom {
    right: 18px;
    bottom: 18px;
    rotate: 180deg;
  }
  .tarot__front :global(.tarot__art) {
    width: auto;
    max-width: 64%;
    height: auto;
    max-height: 48%;
    object-fit: contain;
    filter: drop-shadow(0 6px 8px rgb(43 26 18 / 0.25));
  }
  .tarot__glyph {
    width: 44%;
    fill: none;
    stroke: var(--suit, var(--ink));
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tarot__title {
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--ink);
    text-wrap: balance;
  }
  /* the whole face turns the card */
  .tarot__turn {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    border-radius: 14px;
    background: transparent;
    cursor: pointer;
  }
  .tarot__turn:focus-visible {
    outline: 2px solid var(--heart);
    outline-offset: 4px;
    box-shadow: none;
  }
  .tarot:not(.is-turned):hover .tarot__front {
    border-color: var(--heart);
  }

  /* the back: Teha's black card with the gold frame, the words set inside the frame */
  .tarot__back {
    transform: rotateY(180deg);
    gap: 0.6em;
    /* the frame's corner stars reach about 18% in; the words stay inside them */
    padding: 21% 15% 19%;
    overflow: hidden;
    color: #efe6d3;
    font-size: clamp(0.78rem, 4.6cqi, 1rem);
    background: #161414 var(--card-back) center / 100% 100% no-repeat;
    border: 0;
  }
  .tarot__back-title {
    font-weight: 700;
    font-size: 0.72em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d9b46a;
  }
  .tarot__body {
    color: #efe6d3;
    line-height: 1.55;
  }
  .tarot__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tarot__items li {
    padding: 0.2em 0.5em;
    border: 1px solid rgb(217 180 106 / 0.5);
    font-size: 0.82em;
    color: #efe6d3;
  }
  .tarot__links a {
    color: #e8c98a;
  }
  .tarot__music {
    align-self: flex-start;
    padding: 0.5em 1em;
    font-size: 0.72em;
    color: #efe6d3;
    border-color: #d9b46a;
  }
  .tarot__music[aria-pressed='true'] {
    color: var(--card);
    background: var(--heart);
    border-color: var(--heart);
  }
  .tarot__back-btn {
    margin-top: auto;
    align-self: flex-start;
    min-height: var(--touch);
    padding: 0;
    border: 0;
    background: transparent;
    font-weight: 700;
    font-size: 0.72em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d9b46a;
    cursor: pointer;
  }
  .tarot__back-btn:hover {
    color: #efe6d3;
  }
  .tarot__back-btn:focus-visible {
    outline: 2px solid #d9b46a;
  }

  /* very small cards (the smallest phones): a little less air, so the longest words still fit */
  @container (max-width: 250px) {
    .tarot__back {
      padding: 19% 13% 15%;
      gap: 0.45em;
      font-size: 0.74rem;
    }
    .tarot__body {
      line-height: 1.45;
    }
  }

  /* without JS every card shows its words, and nothing pretends to turn */
  :global(html:not(.js)) .tarot__inner {
    transform: none;
    aspect-ratio: auto;
  }
  :global(html:not(.js)) .tarot__front {
    display: none;
  }
  :global(html:not(.js)) .tarot__back {
    position: relative;
    transform: none;
    min-height: 100%;
  }
  :global(html:not(.js)) .tarot__back-btn {
    display: none;
  }

  @media (max-width: 959px) {
    .deck__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* phones: a hand of cards to swipe through */
  @media (max-width: 599px) {
    .deck__cards {
      display: flex;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      padding: var(--space-3) 14vw var(--space-4);
      margin-inline: calc(var(--gutter) * -1);
      scrollbar-width: none;
    }
    .tarot {
      flex: 0 0 72vw;
      scroll-snap-align: center;
    }
    .wonder__roses {
      width: 34vw;
      top: 2%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tarot__inner {
      transition: none;
    }
    .wonder.is-live .wonder__bird,
    .wonder.is-live .wonder__bird :global(img) {
      animation: none;
    }
    .wonder__roses :global(.wonder__rose--red) {
      clip-path: none;
    }
  }
</style>

<script>
  import { sfx } from '../lib/sfx';

  function setup() {
    document.querySelectorAll<HTMLElement>('[data-tarot]').forEach((card) => {
      const turn = card.querySelector<HTMLButtonElement>('[data-turn]');
      const back = card.querySelector<HTMLElement>('[data-back]');
      const front = card.querySelector<HTMLElement>('[data-front]');
      const backBtn = card.querySelector<HTMLButtonElement>('[data-turn-back]');
      if (!turn || !back || !front || !backBtn) return;
      // the hidden side can't be reached: its links and buttons stay out of the tab order
      back.inert = true;
      const set = (turned: boolean) => {
        card.classList.toggle('is-turned', turned);
        turn.setAttribute('aria-expanded', String(turned));
        back.inert = !turned;
        front.inert = turned;
        sfx('card');
        // move focus with the card, after it has turned far enough to see
        window.setTimeout(() => (turned ? backBtn : turn).focus({ preventScroll: true }), 120);
      };
      turn.onclick = () => set(true);
      backBtn.onclick = () => set(false);
      card.onkeydown = (e) => {
        if (e.key === 'Escape' && card.classList.contains('is-turned')) set(false);
      };
    });

    // the music card plays the site's music: it presses the same switch as the speaker in the top bar
    const toggle = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const music = document.querySelector<HTMLButtonElement>('[data-music]');
    const label = music?.querySelector<HTMLElement>('[data-music-label]');
    if (!toggle || !music || !label) return;
    const sync = () => {
      const on = toggle.getAttribute('aria-pressed') === 'true';
      music.setAttribute('aria-pressed', String(on));
      label.textContent = on ? (music.dataset.pause ?? '') : (music.dataset.play ?? '');
    };
    music.onclick = () => toggle.click();
    new MutationObserver(sync).observe(toggle, { attributes: true, attributeFilter: ['aria-pressed'] });
    sync();
  }
  // Cards lean toward the pointer (mouse only, not while turned, not under reduced motion);
  // the bird only crosses while the chapter is on screen.
  function setupWonder() {
    const wonder = document.querySelector<HTMLElement>('.wonder');
    if (!wonder) return;
    const io = new IntersectionObserver(([e]) => wonder.classList.toggle('is-live', !!e?.isIntersecting));
    io.observe(wonder);
    // the top bar turns light while this chapter is under it (a strip at the top of the screen)
    const under = new IntersectionObserver(([e]) => document.documentElement.classList.toggle('nav-light', !!e?.isIntersecting), {
      rootMargin: '0px 0px -92% 0px',
    });
    under.observe(wonder);
    document.addEventListener(
      'astro:before-swap',
      () => {
        io.disconnect();
        under.disconnect();
        document.documentElement.classList.remove('nav-light');
      },
      { once: true },
    );
    if (!window.matchMedia('(pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    wonder.querySelectorAll<HTMLElement>('[data-tarot]').forEach((card) => {
      const inner = card.querySelector<HTMLElement>('.tarot__inner');
      if (!inner) return;
      card.addEventListener('pointermove', (e) => {
        if (card.classList.contains('is-turned')) return;
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.classList.add('is-tilting');
        inner.style.setProperty('--tilt-y', `${(x * 14).toFixed(2)}deg`);
        inner.style.setProperty('--tilt-x', `${(-y * 12).toFixed(2)}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-tilting');
        inner.style.removeProperty('--tilt-x');
        inner.style.removeProperty('--tilt-y');
      });
    });
  }
  document.addEventListener('astro:page-load', () => {
    setup();
    setupWonder();
  });
</script>
