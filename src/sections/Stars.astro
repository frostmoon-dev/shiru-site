---
import { Image } from 'astro:assets';
import { chapters, hasStars, stars, ui } from '../content/site';
import { cutouts } from '../content/photos';
import SectionHead from '../components/SectionHead.astro';

// Only built once the signs are filled in (src/content/site.ts → stars).
const ch = chapters.find((c) => c.id === 'stars');

// Tropical zodiac: symbol (text presentation), element and the usual date range.
const ZODIAC: Record<string, { symbol: string; element: string; dates: string }> = {
  aries: { symbol: '♈︎', element: 'Fire', dates: '21 Mar – 19 Apr' },
  taurus: { symbol: '♉︎', element: 'Earth', dates: '20 Apr – 20 May' },
  gemini: { symbol: '♊︎', element: 'Air', dates: '21 May – 20 Jun' },
  cancer: { symbol: '♋︎', element: 'Water', dates: '21 Jun – 22 Jul' },
  leo: { symbol: '♌︎', element: 'Fire', dates: '23 Jul – 22 Aug' },
  virgo: { symbol: '♍︎', element: 'Earth', dates: '23 Aug – 22 Sep' },
  libra: { symbol: '♎︎', element: 'Air', dates: '23 Sep – 22 Oct' },
  scorpio: { symbol: '♏︎', element: 'Water', dates: '23 Oct – 21 Nov' },
  sagittarius: { symbol: '♐︎', element: 'Fire', dates: '22 Nov – 21 Dec' },
  capricorn: { symbol: '♑︎', element: 'Earth', dates: '22 Dec – 19 Jan' },
  aquarius: { symbol: '♒︎', element: 'Air', dates: '20 Jan – 18 Feb' },
  pisces: { symbol: '♓︎', element: 'Water', dates: '19 Feb – 20 Mar' },
};
const cards = (['sun', 'moon', 'rising'] as const)
  .map((role) => ({ role, sign: stars[role].trim(), ...stars.roles[role] }))
  .filter((c) => c.sign)
  .map((c) => ({ ...c, info: ZODIAC[c.sign.toLowerCase()] }));
---

{
  hasStars() && ch && (
    <section id={ch.id} class="section stars" data-tone="night" aria-labelledby="stars-title">
      {/* the glasshouse at dusk: the arched iron framing against the sky, the moon, a slow star wheel, leaves along the glass */}
      <div class="night" aria-hidden="true">
        <div class="night__sky" />
        <Image class="night__moon" src={cutouts.moon} alt="" widths={[240, 480]} sizes="(max-width: 719px) 120px, 16vw" loading="lazy" decoding="async" />
        <Image class="night__chart" src={cutouts.starChart} alt="" widths={[480, 900]} sizes="60vw" loading="lazy" decoding="async" />
        <svg class="night__frame" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMin slice">
          <path d="M14 600 V150 Q14 40 120 18 Q226 40 226 150 V600 M120 18 V600 M14 300 H226 M254 600 V150 Q254 40 360 18 Q466 40 466 150 V600 M360 18 V600 M254 300 H466 M494 600 V150 Q494 40 600 18 Q706 40 706 150 V600 M600 18 V600 M494 300 H706 M734 600 V150 Q734 40 840 18 Q946 40 946 150 V600 M840 18 V600 M734 300 H946 M974 600 V150 Q974 40 1080 18 Q1186 40 1186 150 V600 M1080 18 V600 M974 300 H1186 M1214 600 V150 Q1214 40 1320 18 Q1426 40 1426 150 V600 M1320 18 V600 M1214 300 H1426" />
        </svg>
        <svg class="night__leaves" viewBox="0 0 1440 320" preserveAspectRatio="none">
          <path d="M0 300 C60 230 90 250 120 300 C150 220 200 220 230 300 C260 250 300 200 330 300 C370 240 410 250 440 300 C470 210 520 220 560 300 C600 250 640 230 680 300 C720 220 770 230 800 300 C840 250 880 210 920 300 C960 240 1000 250 1040 300 C1080 220 1120 230 1160 300 C1200 250 1250 220 1290 300 C1330 240 1380 240 1440 300 V320 H0 Z" />
        </svg>
        <span class="night__fly"><Image src={cutouts.dragonfly} alt="" width={140} loading="lazy" decoding="async" /></span>
      </div>
      <div class="container">
        <SectionHead id="stars-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={stars.title} lead={stars.lead} />
        <ul class="stars__cards" data-effect="reveal" data-effect-options='{"type":"rise","targets":"li","stagger":0.12}'>
          {cards.map((c) => (
            <li class="star" style={`--sway:${4.6 + ['sun', 'moon', 'rising'].indexOf(c.role) * 0.9}s; --delay:-${['sun', 'moon', 'rising'].indexOf(c.role) * 1.3}s`}>
              <p class="star__role">
                {c.label} <span class="star__note">· {c.note}</span>
              </p>
              {c.info && (
                <span class="star__symbol" aria-hidden="true">
                  {c.info.symbol}
                </span>
              )}
              <h3 class="star__sign">{c.sign}</h3>
              {c.info && (
                <p class="star__meta">
                  {c.info.element} · {c.info.dates}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* ================= the dusk glasshouse ================= */
  .stars {
    isolation: isolate;
    overflow: hidden;
    background: #2a2a1f;
    padding-bottom: calc(var(--section-pad) + 6rem);
  }
  .stars > .container {
    position: relative;
    z-index: 2;
  }
  .night {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* a cold, bruised sky with pin-prick stars that won't hold still */
  .night__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1px 1px at 12% 18%, #f1efe2 50%, transparent 51%),
      radial-gradient(1px 1px at 32% 8%, #f1efe2 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 58% 22%, #f1efe2 50%, transparent 51%),
      radial-gradient(1px 1px at 76% 12%, #f1efe2 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 34%, #f1efe2 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 22% 42%, #f1efe2 50%, transparent 51%),
      radial-gradient(1px 1px at 46% 36%, #f1efe2 50%, transparent 51%),
      radial-gradient(1px 1px at 68% 48%, #f1efe2 50%, transparent 51%),
      radial-gradient(ellipse at 70% 10%, rgb(201 200 161 / 0.16), transparent 55%),
      linear-gradient(#4b4c39, #3a3a2c 45%, #2a2a1f);
    animation: twinkle 5s steps(5, end) infinite;
  }
  @keyframes twinkle {
    50% {
      filter: brightness(1.25);
    }
  }
  /* Teha's moon, glow and all; it breathes, very slowly */
  .stars :global(.night__moon) {
    position: absolute;
    top: 4%;
    right: 7%;
    width: clamp(150px, 17vw, 270px);
    height: auto;
    animation: moon-breathe 7s ease-in-out infinite alternate;
  }
  @keyframes moon-breathe {
    to {
      scale: 1.04;
      filter: brightness(1.08);
    }
  }
  /* the old star chart turns behind everything, very slowly */
  .stars :global(.night__chart) {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(70vw, 760px);
    height: auto;
    translate: -50% -50%;
    opacity: 0.12;
    filter: grayscale(1) invert(1) contrast(1.2);
    mix-blend-mode: screen;
    animation: chart-turn 140s linear infinite;
  }
  @keyframes chart-turn {
    to {
      rotate: 360deg;
    }
  }
  /* the glasshouse's arched iron framing, silhouetted against the dusk */
  .night__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .night__frame path {
    fill: none;
    stroke: #1f1f17;
    stroke-width: 5;
    opacity: 0.55;
  }
  /* leaves pressed against the glass along the bottom */
  .night__leaves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: clamp(90px, 12vw, 180px);
  }
  .night__leaves path {
    fill: #1f1f17;
  }
  /* now and then the dragonfly loops across the sky */
  .night__fly {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(60px, 6vw, 96px);
    offset-path: path('M -120 260 C 200 80, 420 360, 680 180 S 1100 40, 1600 220');
    offset-rotate: auto 90deg;
    offset-distance: 0%;
    opacity: 0;
  }
  .night__fly :global(img) {
    width: 100%;
    height: auto;
    filter: invert(0.85) sepia(0.4) drop-shadow(0 0 6px rgb(232 205 140 / 0.35));
  }
  .stars.is-live .night__fly {
    animation: fly-across 14s ease-in-out infinite 2s;
  }
  @keyframes fly-across {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    4% {
      opacity: 0.9;
    }
    40% {
      opacity: 0.9;
    }
    46%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  /* ================= the three cards, hung on threads ================= */
  .stars__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    /* top margin comes from .section-head + * (the shared rhythm) */
    margin-inline: 0;
    margin-bottom: 0;
    padding-top: var(--space-6);
  }
  .star {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-3);
    text-align: center;
    color: var(--parchment);
    background: #2f2f23;
    border: 1px solid var(--gold);
    outline: 1px solid rgb(168 138 74 / 0.6);
    outline-offset: -8px;
    box-shadow: 0 24px 40px rgb(0 0 0 / 0.35);
    transform-origin: 50% calc(-1 * var(--space-6));
    animation: sway var(--sway, 5s) ease-in-out infinite alternate var(--delay, 0s);
  }
  /* the thread it hangs from */
  .star::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 1px);
    left: 50%;
    width: 1px;
    height: var(--space-6);
    background: linear-gradient(rgb(201 200 161 / 0), rgb(201 200 161 / 0.7));
  }
  @keyframes sway {
    from {
      rotate: -2.2deg;
    }
    to {
      rotate: 2.2deg;
    }
  }
  .star:hover {
    animation-duration: 1.2s;
  }
  .star__role {
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage-pale);
  }
  .star__note {
    color: #d8cdbd;
  }
  .star__symbol {
    font-family: 'Segoe UI Symbol', 'Noto Sans Symbols', 'DejaVu Sans', serif;
    font-size: 3.5rem;
    line-height: 1;
    color: #f1efe2;
    text-shadow: 0 0 18px rgb(232 205 140 / 0.45);
  }
  .star__sign {
    font-size: var(--step-3);
    color: var(--parchment);
  }
  .star__meta {
    font-size: var(--text-small);
    color: #d8cdbd;
  }
  @media (max-width: 719px) {
    /* phones: a small moon tucked into the corner, clear of the title */
    .stars :global(.night__moon) {
      top: calc(var(--touch) + var(--space-1));
      right: var(--space-1);
      width: 92px;
    }
    .stars__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(var(--space-6) + var(--space-3));
      padding-inline: var(--space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .night__sky,
    .stars :global(.night__chart),
    .stars :global(.night__moon),
    .star,
    .stars.is-live .night__fly {
      animation: none;
    }
  }
</style>

<script>
  // the dragonfly only flies while the dusk is on screen
  function setupNight() {
    const night = document.querySelector<HTMLElement>('.stars');
    if (!night) return;
    const io = new IntersectionObserver(([e]) => night.classList.toggle('is-live', !!e?.isIntersecting));
    io.observe(night);
    // the top bar turns to dusk while this chapter is under it (a strip at the top of the screen)
    const under = new IntersectionObserver(([e]) => document.documentElement.classList.toggle('nav-dark', !!e?.isIntersecting), {
      rootMargin: '-1px 0px -92% 0px',
    });
    under.observe(night);
    document.addEventListener(
      'astro:before-swap',
      () => {
        io.disconnect();
        under.disconnect();
        document.documentElement.classList.remove('nav-dark');
      },
      { once: true },
    );
  }
  document.addEventListener('astro:page-load', setupNight);
</script>
