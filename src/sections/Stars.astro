---
import { Image } from 'astro:assets';
import { chapters, hasStars, stars, ui } from '../content/site';
import { cutouts } from '../content/photos';
import SectionHead from '../components/SectionHead.astro';
import { ahs } from '../lib/ahs';

// Only built once the signs are filled in (src/content/site.ts → stars).
const ch = chapters.find((c) => c.id === 'stars');

// Tropical zodiac: symbol (text presentation), element and the usual date range.
const ZODIAC: Record<string, { symbol: string; element: string; dates: string }> = {
  aries: { symbol: '♈︎', element: 'Fire', dates: '21 Mar – 19 Apr' },
  taurus: { symbol: '♉︎', element: 'Earth', dates: '20 Apr – 20 May' },
  gemini: { symbol: '♊︎', element: 'Air', dates: '21 May – 20 Jun' },
  cancer: { symbol: '♋︎', element: 'Water', dates: '21 Jun – 22 Jul' },
  leo: { symbol: '♌︎', element: 'Fire', dates: '23 Jul – 22 Aug' },
  virgo: { symbol: '♍︎', element: 'Earth', dates: '23 Aug – 22 Sep' },
  libra: { symbol: '♎︎', element: 'Air', dates: '23 Sep – 22 Oct' },
  scorpio: { symbol: '♏︎', element: 'Water', dates: '23 Oct – 21 Nov' },
  sagittarius: { symbol: '♐︎', element: 'Fire', dates: '22 Nov – 21 Dec' },
  capricorn: { symbol: '♑︎', element: 'Earth', dates: '22 Dec – 19 Jan' },
  aquarius: { symbol: '♒︎', element: 'Air', dates: '20 Jan – 18 Feb' },
  pisces: { symbol: '♓︎', element: 'Water', dates: '19 Feb – 20 Mar' },
};
const cards = (['sun', 'moon', 'rising'] as const)
  .map((role) => ({ role, sign: stars[role].trim(), ...stars.roles[role] }))
  .filter((c) => c.sign)
  .map((c) => ({ ...c, info: ZODIAC[c.sign.toLowerCase()] }));
---

{
  hasStars() && ch && (
    <section id={ch.id} class="section stars" data-tone="night" aria-labelledby="stars-title">
      {/* a crooked, Burton-ish night: a slow star wheel, a sickly moon, a spiral hill, twisted trees */}
      <div class="night" aria-hidden="true">
        <div class="night__sky" />
        <div class="night__moon" />
        <Image class="night__chart" src={cutouts.starChart} alt="" widths={[480, 900]} sizes="60vw" loading="lazy" decoding="async" />
        <svg class="night__hill" viewBox="0 0 1440 320" preserveAspectRatio="none">
          <path d="M0 320V236c120-10 230-36 340-84 70-30 130-74 196-104 44-20 98-24 128 6 26 26 18 66-14 78-26 10-52-4-50-28 2-18 22-26 36-18M664 54c34 18 62 52 108 84 92 64 214 90 352 98 120 8 222 6 316 2v82z" />
          <path class="night__tree" d="M1180 236c4-46-6-86-28-118m28 40c18-22 40-30 64-26m-74-2c-22-12-34-32-36-56m46 74c10-30 30-46 54-52m-32 132c2-26 10-50 24-70" />
          <path class="night__tree" d="M210 270c-2-36 8-66 28-90m-18 34c-20-10-34-28-38-50m48 30c16-14 34-18 54-14m-46-12c-4-22 2-42 16-58" />
        </svg>
        <span class="night__fly"><Image src={cutouts.dragonfly} alt="" width={140} loading="lazy" decoding="async" /></span>
      </div>
      <div class="container">
        <SectionHead id="stars-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={stars.title} lead={stars.lead} />
        <ul class="stars__cards" data-effect="reveal" data-effect-options='{"type":"rise","targets":"li","stagger":0.12}'>
          {cards.map((c) => (
            <li class="star" style={`--sway:${4.6 + ['sun', 'moon', 'rising'].indexOf(c.role) * 0.9}s; --delay:-${['sun', 'moon', 'rising'].indexOf(c.role) * 1.3}s`}>
              <p class="star__role">
                {c.label} <span class="star__note">· {c.note}</span>
              </p>
              {c.info && (
                <span class="star__symbol" aria-hidden="true">
                  {c.info.symbol}
                </span>
              )}
              <h3 class="star__sign">{ahs(c.sign)}</h3>
              {c.info && (
                <p class="star__meta">
                  {c.info.element} · {c.info.dates}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* ================= the Burton night ================= */
  .stars {
    isolation: isolate;
    overflow: hidden;
    background: #070910;
    padding-bottom: calc(var(--section-pad) + 6rem);
  }
  .stars > .container {
    position: relative;
    z-index: 2;
  }
  .night {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* a cold, bruised sky with pin-prick stars that won't hold still */
  .night__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1px 1px at 12% 18%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1px 1px at 32% 8%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 58% 22%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1px 1px at 76% 12%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 34%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 22% 42%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1px 1px at 46% 36%, #dfe6ef 50%, transparent 51%),
      radial-gradient(1px 1px at 68% 48%, #dfe6ef 50%, transparent 51%),
      radial-gradient(ellipse at 70% 10%, rgb(110 130 160 / 0.22), transparent 55%),
      linear-gradient(#1a2130, #0d111b 55%, #070910);
    animation: twinkle 5s steps(5, end) infinite;
  }
  @keyframes twinkle {
    50% {
      filter: brightness(1.25);
    }
  }
  /* a too-big, slightly sick moon */
  .night__moon {
    position: absolute;
    top: 7%;
    right: 9%;
    width: clamp(110px, 14vw, 210px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 35%, #f1efe2, #cfcab4 55%, #a7a38c);
    box-shadow:
      0 0 40px rgb(230 228 210 / 0.35),
      0 0 120px rgb(160 180 200 / 0.25);
  }
  /* the old star chart turns behind everything, very slowly */
  .stars :global(.night__chart) {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(70vw, 760px);
    height: auto;
    translate: -50% -50%;
    opacity: 0.12;
    filter: grayscale(1) invert(1) contrast(1.2);
    mix-blend-mode: screen;
    animation: chart-turn 140s linear infinite;
  }
  @keyframes chart-turn {
    to {
      rotate: 360deg;
    }
  }
  /* the spiral hill and two crooked trees */
  .night__hill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: clamp(140px, 22vw, 300px);
  }
  .night__hill path:first-child {
    fill: #030407;
    stroke: rgb(180 196 214 / 0.25);
    stroke-width: 1.5;
  }
  .night__tree {
    fill: none;
    stroke: #030407;
    stroke-width: 7;
    stroke-linecap: round;
  }
  /* now and then the dragonfly loops across the sky */
  .night__fly {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(60px, 6vw, 96px);
    offset-path: path('M -120 260 C 200 80, 420 360, 680 180 S 1100 40, 1600 220');
    offset-rotate: auto 90deg;
    offset-distance: 0%;
    opacity: 0;
  }
  .night__fly :global(img) {
    width: 100%;
    height: auto;
    filter: invert(0.85) drop-shadow(0 0 6px rgb(200 220 240 / 0.4));
  }
  .stars.is-live .night__fly {
    animation: fly-across 14s ease-in-out infinite 2s;
  }
  @keyframes fly-across {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    4% {
      opacity: 0.9;
    }
    40% {
      opacity: 0.9;
    }
    46%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  /* ================= the three cards, hung on threads ================= */
  .stars__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    /* top margin comes from .section-head + * (the shared rhythm) */
    margin-inline: 0;
    margin-bottom: 0;
    padding-top: var(--space-6);
  }
  .star {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-3);
    text-align: center;
    color: var(--bone);
    background:
      linear-gradient(#0c0f17, #0c0f17) padding-box,
      repeating-linear-gradient(90deg, #ecebe3 0 7px, #0a0b10 7px 14px) border-box;
    border: 7px solid transparent;
    box-shadow: 0 24px 40px rgb(0 0 0 / 0.55);
    transform-origin: 50% calc(-1 * var(--space-6));
    animation: sway var(--sway, 5s) ease-in-out infinite alternate var(--delay, 0s);
  }
  /* the thread it hangs from */
  .star::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    width: 1px;
    height: var(--space-6);
    background: linear-gradient(rgb(232 220 194 / 0), rgb(232 220 194 / 0.55));
  }
  @keyframes sway {
    from {
      rotate: -2.2deg;
    }
    to {
      rotate: 2.2deg;
    }
  }
  .star:hover {
    animation-duration: 1.2s;
  }
  .star__role {
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c9d4e2;
  }
  .star__note {
    color: var(--muted);
  }
  .star__symbol {
    font-family: 'Segoe UI Symbol', 'Noto Sans Symbols', 'DejaVu Sans', serif;
    font-size: 3.5rem;
    line-height: 1;
    color: #f1efe2;
    text-shadow: 0 0 18px rgb(200 220 240 / 0.45);
  }
  .star__sign {
    font-size: var(--step-3);
    color: var(--bone);
  }
  .star__meta {
    font-size: var(--text-small);
    color: #aeb8c6;
  }
  @media (max-width: 719px) {
    /* phones: a small moon tucked into the corner, clear of the title */
    .night__moon {
      top: calc(var(--touch) + var(--space-3));
      right: var(--space-3);
      width: 56px;
    }
    .stars__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(var(--space-6) + var(--space-3));
      padding-inline: var(--space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .night__sky,
    .stars :global(.night__chart),
    .star,
    .stars.is-live .night__fly {
      animation: none;
    }
  }
</style>

<script>
  // the dragonfly only flies while the night is on screen
  function setupNight() {
    const night = document.querySelector<HTMLElement>('.stars');
    if (!night) return;
    const io = new IntersectionObserver(([e]) => night.classList.toggle('is-live', !!e?.isIntersecting));
    io.observe(night);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', setupNight);
</script>
