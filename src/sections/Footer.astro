---
import { footer, haunt, site, work } from '../content/site';
import MarginNote from '../components/MarginNote.astro';
import { isWorkSite } from '../lib/mode';

interface Props {
  page?: 'home' | 'work' | 'other';
}
const { page = 'home' } = Astro.props;
const asWork = page === 'work' || isWorkSite;
const email = asWork ? work.email : site.email;
const name = asWork ? work.name : site.name;
const year = new Date().getFullYear();
---

<footer class="section footer" data-tone="void">
  <div class="container">
    <p class="kicker">Case closed · for now</p>
    <p class="footer__line display-face" data-effect="typewriter" data-effect-options={JSON.stringify({ typo: footer.typo })}>{footer.line}</p>
    <p class="footer__mail"><a href={`mailto:${email}`}>{email}</a></p>
    {!asWork && <MarginNote text={haunt.notes.footer} tilt={-3} />}

    <div class="footer__base">
      <p>{footer.privacy}</p>
      <p>{footer.copyright(year, name)} {footer.fontsCredit}</p>
      <p><a class="footer__top" href="#top">Back to the first page <span aria-hidden="true">↑</span></a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    /* leaves room for the eye dock at the bottom right */
    padding-bottom: calc(var(--space-7) + var(--space-4));
  }
  .footer__line {
    margin-top: var(--space-3);
    font-size: var(--display-2);
    line-height: 1;
    color: var(--bone);
    min-height: 1em;
  }
  .footer__mail {
    margin-top: var(--space-4);
    font-size: var(--lead);
  }
  .footer__mail a {
    color: var(--bone);
  }
  .footer__base {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-2);
    max-width: 62ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--muted);
  }
  .footer__top {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone);
  }
</style>
