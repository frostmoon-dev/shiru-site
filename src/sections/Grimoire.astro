---
import { chapters, grimoire, ui } from '../content/site';
import ChapterHeading from '../components/ChapterHeading.astro';
import GrimoireBook from '../islands/GrimoireBook';

const ch = chapters.find((c) => c.id === 'grimoire')!;
const entries = grimoire.entries.map(({ slug, numeral, title, date, excerpt }) => ({ slug, numeral, title, date, excerpt }));
const labels = {
  title: grimoire.title,
  open: grimoire.open,
  close: grimoire.close,
  prev: grimoire.prev,
  next: grimoire.next,
  hint: grimoire.hint,
  binding: grimoire.binding,
  readEntry: grimoire.readEntry,
  noWebgl: ui.noWebgl,
};
---

<section id={ch.id} class="grimoire" data-tone="sepia" aria-labelledby="grimoire-title">
  <div class="burn" aria-hidden="true" data-effect="section-wipe" data-effect-options='{"variant":"burn"}'>
    <div class="burn__edge"></div>
    <div class="burn__bloom"></div>
  </div>
  <div class="grimoire__inner">
    <ChapterHeading id="grimoire-title" label={grimoire.label} title={grimoire.title} drip="#5c0e12" />
    <p class="grimoire__intro flavour">{grimoire.intro}</p>
    <p class="grimoire__hint caption" data-hint="grimoire">Open it. It won’t mind.</p>

    <div class="grimoire__book">
      <GrimoireBook client:visible entries={entries} labels={labels} />
    </div>

    <!-- Without JS (or before the book wakes) the chapters are a plain table of contents. -->
    <ol class="grimoire__toc">
      {
        grimoire.entries.map((e) => (
          <li>
            <span class="label">{e.numeral}</span>
            <a href={`/grimoire/${e.slug}/`}>{e.title}</a>
            <span class="caption">{e.excerpt}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .grimoire {
    position: relative;
    overflow-x: clip;
    padding: var(--space-8) var(--gutter) var(--space-8);
  }
  .grimoire__inner {
    position: relative;
    z-index: var(--z-content);
    max-width: 76rem;
    margin-inline: auto;
  }
  .grimoire__intro {
    margin-top: var(--space-3);
    max-width: 34ch;
    margin-left: clamp(0rem, 8vw, 8rem);
  }
  .grimoire__hint {
    margin-left: clamp(0rem, 8vw, 8rem);
    margin-top: var(--space-1);
  }
  .grimoire__book {
    margin-top: var(--space-5);
  }
  .grimoire__toc {
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
  .grimoire__toc li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--space-2);
  }
  .grimoire__toc .caption {
    grid-column: 2;
  }
  /* JS visitors get the book; the plain list is for no-JS (avoids a layout jump on hydrate). */
  :global(html.js) .grimoire__toc {
    display: none;
  }
  :global(html:not(.js)) .grimoire__book {
    display: none;
  }

  /* film burn between the case files and the grimoire */
  .burn {
    position: absolute;
    left: 0;
    right: 0;
    top: -2px;
    height: 140px;
    pointer-events: none;
    z-index: var(--z-content);
  }
  .burn__edge {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 30% 60% at 22% 0%, rgb(5 3 4 / 0.9), transparent 70%),
      radial-gradient(ellipse 18% 50% at 68% 0%, rgb(43 18 21 / 0.85), transparent 70%),
      linear-gradient(to bottom, var(--void), rgb(92 14 18 / 0.35) 30%, transparent);
  }
  .burn__bloom {
    position: absolute;
    left: 50%;
    top: 0;
    width: 120vmax;
    height: 120vmax;
    margin: -60vmax 0 0 -60vmax;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(201 162 74 / 0.55), rgb(163 20 27 / 0.35) 30%, rgb(43 18 21 / 0) 60%);
    opacity: 0;
    mix-blend-mode: screen;
  }
</style>
