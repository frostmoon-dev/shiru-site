---
import { chapters, grimoire, ui } from '../content/site';
import SectionHead from '../components/SectionHead.astro';
import GrimoireBook from '../islands/GrimoireBook';

const ch = chapters.find((c) => c.id === 'grimoire')!;
const entries = grimoire.entries.map(({ slug, numeral, title, when, date, excerpt }) => ({ slug, numeral, title, when, date, excerpt }));
const labels = {
  title: grimoire.title,
  open: grimoire.open,
  close: grimoire.close,
  prev: grimoire.prev,
  next: grimoire.next,
  hint: grimoire.hint,
  binding: grimoire.binding,
  readEntry: grimoire.readEntry,
  noWebgl: ui.noWebgl,
};
---

<section id={ch.id} class="section grimoire" data-tone="void" aria-labelledby="grimoire-title">
  <div class="container">
    <SectionHead id="grimoire-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={grimoire.title} lead={grimoire.intro}>
      <p class="grimoire__hint" data-hint="grimoire">Open it. It won’t mind.</p>
    </SectionHead>

    <div class="grimoire__book">
      <GrimoireBook client:visible entries={entries} labels={labels} />
    </div>

    <!-- Without JS (or before the book wakes) the chapters are a plain table of contents. -->
    <ol class="grimoire__toc">
      {
        grimoire.entries.map((e) => (
          <li>
            <span class="kicker">{e.numeral}</span>
            <a href={`/grimoire/${e.slug}/`}>{e.title}</a>
            <span>{e.excerpt}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .grimoire {
    overflow-x: clip;
  }
  .grimoire__hint {
    font-size: var(--text-small);
    color: var(--muted);
  }
  .grimoire__toc {
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    max-width: var(--measure);
  }
  .grimoire__toc li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .grimoire__toc li > span:last-child {
    grid-column: 2;
    color: var(--text-body);
  }
  /* JS visitors get the book; the plain list is for no-JS (avoids a layout jump on hydrate). */
  :global(html.js) .grimoire__toc {
    display: none;
  }
  :global(html:not(.js)) .grimoire__book {
    display: none;
  }
</style>

<script>
  // Opening a chapter from here marks where the reader came from, so the chapter's close button
  // (and Esc) goes Back to this exact scroll position instead of reloading the chapter heading.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href^="/grimoire/"]');
    if (!a || !a.closest('#grimoire')) return;
    try {
      sessionStorage.setItem('site:from-grimoire', '1');
    } catch {
      /* storage blocked: the close button just links back */
    }
  });
</script>
