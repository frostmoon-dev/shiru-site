---
import { Image, getImage } from 'astro:assets';
import { chapters, site, tea, ui, work, workContact } from '../content/site';
import { collage, design } from '../content/photos';
import Icon from '../components/Icon.astro';
import TeaIcon from '../components/TeaIcon.astro';
import SectionHead from '../components/SectionHead.astro';

interface Props {
  /** "work": the work page's contact chapter (professional addresses only). */
  variant?: 'home' | 'work';
}
const { variant = 'home' } = Astro.props;
const isWork = variant === 'work';
const ch = chapters.find((c) => c.id === (isWork ? 'contact' : 'tea'))!;
const copy = isWork ? { title: workContact.title, intro: workContact.intro, links: workContact.links } : { title: tea.title, intro: tea.intro, links: tea.links };
const email = isWork ? work.email : site.email;
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() || '';
const mode = endpoint ? 'endpoint' : 'mailto';
const action = endpoint || `mailto:${email}`;
const paper = await getImage({ src: collage.paper, width: 900, format: 'webp', quality: 72 });
const gingham = await getImage({ src: design.gingham, width: 1600, format: 'webp', quality: 60 });
---

<section id={ch.id} class="section tea" data-tone="void" aria-labelledby="tea-title" style={`--gingham:url(${gingham.src})`}>
  <div class="container">
    <SectionHead id="tea-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={copy.title} lead={copy.intro} />

    <div class="tea__grid">
      <ul class="contact" data-effect="reveal" data-effect-options='{"type":"rise","targets":"li","stagger":0.08}'>
        {
          copy.links.map((l) => (
            <li>
              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined} target={l.href.startsWith('http') ? '_blank' : undefined}>
                <TeaIcon name={l.icon} />
                <span class="contact__label">{l.label}</span>
                <span class="contact__detail">{l.detail}</span>
                {l.href.startsWith('http') && <span class="visually-hidden"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="stage" data-stage>
        <div class="envelope" data-envelope data-mode={mode} data-effect="reveal" data-effect-options='{"type":"settle"}'>
          <Image class="envelope__img" src={collage.envelope} alt="" widths={[480, 720, 1100]} sizes="(max-width: 959px) 90vw, 36rem" loading="lazy" decoding="async" />
          <button class="envelope__seal" type="button" data-seal aria-expanded="false" aria-controls="letter">
            <span class="visually-hidden">{tea.sealLabel}</span>
          </button>
          <p class="envelope__hint" data-hint="seal"><span aria-hidden="true">↑ </span>{tea.sealHint}</p>
        </div>

        <div class="letter" id="letter" data-tone="bone" data-letter style={`--paper:url(${paper.src})`}>
          <h3 class="letter__title">{tea.formTitle}</h3>
        <form class="letter__form" action={action} method="post" enctype={mode === 'mailto' ? 'text/plain' : undefined} novalidate data-form>
          <div class="field">
            <label for="f-name">{tea.fields.name.label}</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
            <p class="field__error" id="e-name" hidden><Icon name="warn" size={18} /><span>{tea.fields.name.error}</span></p>
          </div>
          <div class="field">
            <label for="f-email">{tea.fields.email.label}</label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="e-email" />
            <p class="field__error" id="e-email" hidden><Icon name="warn" size={18} /><span>{tea.fields.email.error}</span></p>
          </div>
          <div class="field">
            <label for="f-message">{tea.fields.message.label}</label>
            <textarea id="f-message" name="message" rows="5" required aria-describedby="e-message"></textarea>
            <p class="field__error" id="e-message" hidden><Icon name="warn" size={18} /><span>{tea.fields.message.error}</span></p>
          </div>
          <div class="field field--trap" aria-hidden="true">
            <label for="f-website">{tea.fields.honeypot}</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="letter__actions">
            <button class="btn btn--solid" type="submit" data-submit aria-describedby={mode === 'mailto' ? 'submit-note' : undefined}>
              <Icon name="quill" size={18} />
              <span data-submit-label>{mode === 'mailto' ? tea.submitMailto : tea.submit}</span>
            </button>
            <button class="btn letter__fold" type="button" data-fold>{tea.closeEnvelope}</button>
          </div>
          {mode === 'mailto' && <p class="letter__note" id="submit-note">{tea.submitMailtoNote}</p>}
          <div class="letter__status" role="status" aria-live="polite" data-status></div>
        </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  type="application/json"
  id="tea-copy"
  set:html={JSON.stringify({
    sending: tea.sending,
    success: tea.success,
    successMailto: tea.successMailto,
    error: tea.error(email),
    email,
  })}
></script>
<template id="tea-icon-error"><Icon name="warn" size={20} /></template>
<template id="tea-icon-success"><Icon name="check" size={20} /></template>

<style>
  .tea {
    overflow-x: clip;
    isolation: auto;
  }
  /* the tablecloth: gingham, drained of colour and nearly lost in the dark */
  .tea::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gingham) center / 34rem auto repeat;
    filter: grayscale(1);
    opacity: 0.07;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 60%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 70% 60%, #000, transparent 75%);
    pointer-events: none;
  }
  .tea .container {
    position: relative;
    z-index: var(--z-content);
  }
  .tea__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  /* ---- contact: icon + words, same height, hairlines between ---- */
  .contact {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
    align-self: start;
  }
  .contact a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--bone);
    text-decoration: none;
  }
  .contact a :global(svg) {
    grid-row: 1 / span 2;
    width: 2.5rem;
    height: 2.5rem;
    transition: transform var(--dur-quick) var(--ease-out);
  }
  .contact__label {
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact__detail {
    color: var(--bone);
  }
  .contact a:hover :global(svg),
  .contact a:focus-visible :global(svg) {
    transform: rotate(-6deg) translateY(-2px);
  }
  .contact a:hover .contact__detail {
    text-decoration: underline;
    text-decoration-color: var(--blood);
    text-underline-offset: 0.25em;
  }

  /* ---- the stage: envelope and letter share one spot ---- */
  .stage {
    display: grid;
    justify-items: center;
    align-items: start;
    /* the letter measures itself against this */
    container-type: inline-size;
  }
  .stage > * {
    grid-area: 1 / 1;
  }
  .envelope {
    position: relative;
    z-index: 2;
    width: min(100%, 30rem);
    aspect-ratio: 766 / 638;
    margin-bottom: var(--space-7);
  }
  .envelope__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    rotate: -3deg;
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.55));
  }
  .envelope__seal {
    position: absolute;
    z-index: 3;
    left: 50.6%;
    top: 52.6%;
    width: 21%;
    aspect-ratio: 1;
    min-width: var(--touch);
    translate: -50% -50%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transition:
      transform var(--dur-quick) var(--ease-out),
      box-shadow var(--dur-base);
  }
  .envelope__seal:hover {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 0 0 2px rgb(232 220 194 / 0.4), 0 0 32px 6px rgb(163 20 27 / 0.35);
  }
  .envelope__seal:active {
    transform: scale(0.96);
  }
  .envelope__seal:focus-visible {
    outline-color: var(--bone);
    box-shadow: 0 0 0 6px var(--void);
  }
  .envelope.is-opened .envelope__seal {
    pointer-events: none;
  }
  .envelope__hint {
    position: absolute;
    left: 50%;
    top: calc(100% + var(--space-3));
    translate: -50% 0;
    white-space: nowrap;
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    animation: hint-sway 2.4s var(--ease-ink) infinite;
  }
  @keyframes hint-sway {
    50% {
      translate: -50% -4px;
    }
  }
  .stage.is-open .envelope {
    visibility: hidden;
    position: absolute;
  }

  /* ---- the letter (form) on the torn paper ---- */
  .letter {
    position: relative;
    z-index: 1;
    /*
      The torn paper is laid on as a 9-slice: its torn top (with the second sheet and that
      sheet's tear line, the top 23% of the picture), its torn bottom and its ragged sides keep
      their natural proportions at any size; only the plain middle stretches with the form.
      The border widths are those slices at the letter's own scale, so the writing always starts
      on the main sheet, below the tear, with even room on every side.
    */
    --w: min(100cqi, 36rem);
    width: var(--w);
    border-style: solid;
    border-color: transparent;
    border-width: calc(var(--w) * 0.21) calc(var(--w) * 0.045) calc(var(--w) * 0.073) calc(var(--w) * 0.07);
    border-image-source: var(--paper);
    border-image-slice: 23% 4.5% 8% 7% fill;
    border-image-repeat: stretch;
    padding: clamp(1.25rem, calc(var(--w) * 0.05), 2rem) calc(var(--w) * 0.075) clamp(1.25rem, calc(var(--w) * 0.045), 1.75rem)
      calc(var(--w) * 0.07);
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.55));
  }
  :global(html.js) .stage:not(.is-opening):not(.is-open) .letter {
    display: none;
  }
  :global(html:not(.js)) .envelope {
    display: none;
  }
  .letter__title {
    font-size: var(--step-2);
    line-height: 1;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }
  .letter__form {
    display: grid;
    gap: var(--space-3);
  }
  .field {
    display: grid;
    gap: var(--space-1);
  }
  .field label {
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: var(--touch);
    padding: var(--space-1);
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: rgb(255 250 235 / 0.4);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--step-0);
    border-radius: 0;
  }
  .field textarea {
    resize: vertical;
    line-height: 1.6;
  }
  .field input:hover,
  .field textarea:hover {
    background-color: rgb(255 250 235 / 0.6);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--blood);
    outline-offset: 2px;
    box-shadow: none;
  }
  /* browser autofill paints fields pale blue: keep them on the paper instead */
  .field input:-webkit-autofill,
  .field input:-webkit-autofill:hover,
  .field input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--ink);
    caret-color: var(--ink);
    box-shadow: inset 0 0 0 100px #f3e8d0;
    transition: background-color 9999s;
  }
  .field input:autofill {
    background-color: rgb(255 250 235 / 0.6);
  }
  .field [aria-invalid='true'] {
    border-bottom: 2px solid var(--error);
  }
  .field input:disabled,
  .field textarea:disabled {
    opacity: 0.6;
  }
  .field__error {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    color: var(--error);
    font-size: var(--text-small);
  }
  .field__error[hidden] {
    display: none;
  }
  .field--trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .letter__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (max-width: 479px) {
    .letter__actions :global(.btn) {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
  .letter__note {
    margin-top: calc(-1 * var(--space-1));
    font-size: var(--text-small);
    font-style: italic;
    color: #4a3828;
  }
  :global(html:not(.js)) .letter__fold {
    display: none;
  }
  .letter__status:empty {
    display: none;
  }
  .letter__status {
    display: flex;
    gap: var(--space-1);
    align-items: flex-start;
    padding: var(--space-2);
    border: 1px solid currentColor;
  }
  .letter__status[data-kind='success'] {
    color: var(--success);
  }
  .letter__status[data-kind='error'] {
    color: var(--error);
  }
  .letter__status[data-kind='sending'] {
    color: var(--fg-muted);
  }

  @media (min-width: 960px) {
    .tea__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
</style>

<script>
  import { markHintUsed } from '../lib/hints';
  import { sfx } from '../lib/sfx';
  import { gsap } from '../lib/motion';
  import { prefersReducedMotion } from '../lib/env';

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bind() {
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    const env = document.querySelector<HTMLElement>('[data-envelope]');
    const seal = document.querySelector<HTMLButtonElement>('[data-seal]');
    const letter = document.querySelector<HTMLElement>('[data-letter]');
    const form = document.querySelector<HTMLFormElement>('[data-form]');
    const copyEl = document.getElementById('tea-copy');
    if (!stage || !env || !seal || !letter || !form || !copyEl) return;
    const copy = JSON.parse(copyEl.textContent ?? '{}') as {
      sending: string;
      success: string;
      successMailto: string;
      error: string;
      email: string;
    };
    const mode = env.dataset.mode;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const fields = {
      name: form.querySelector<HTMLInputElement>('#f-name')!,
      email: form.querySelector<HTMLInputElement>('#f-email')!,
      message: form.querySelector<HTMLTextAreaElement>('#f-message')!,
    };
    const trap = form.querySelector<HTMLInputElement>('#f-website')!;
    let attempted = false;
    let busy = false;

    let tl: gsap.core.Timeline | undefined;
    const envImg = env.querySelector<HTMLElement>('.envelope__img');
    const parts = () => letter.querySelectorAll('.letter__title, .field:not(.field--trap), .letter__actions, .letter__note');

    // Fold the letter back into the envelope.
    const close = () => {
      tl?.kill();
      const done = () => {
        stage.classList.remove('is-opening', 'is-open');
        env.classList.remove('is-opened');
        gsap.set([env, letter, envImg], { clearProps: 'transform,opacity,visibility' });
        seal.setAttribute('aria-expanded', 'false');
        seal.focus({ preventScroll: true });
      };
      if (prefersReducedMotion()) return done();
      stage.classList.remove('is-open');
      stage.classList.add('is-opening');
      tl = gsap
        .timeline({ onComplete: done })
        .to(letter, { yPercent: 14, scale: 0.8, opacity: 0, duration: 0.45, ease: 'power2.in' }, 0)
        .fromTo(env, { yPercent: 50, rotate: -8, opacity: 0 }, { yPercent: 0, rotate: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, 0.2);
    };

    // Break the seal: the envelope opens first, then the paper slides out of it.
    const open = () => {
      if (stage.classList.contains('is-opening') || stage.classList.contains('is-open')) return;
      seal.setAttribute('aria-expanded', 'true');
      markHintUsed('seal');
      sfx('paper');
      window.siteOverlay.open('letter', close);
      env.classList.add('is-opened');
      stage.classList.add('is-opening');
      const settle = () => {
        stage.classList.remove('is-opening');
        stage.classList.add('is-open');
        fields.name.focus({ preventScroll: true });
      };
      if (prefersReducedMotion()) return settle();
      tl = gsap
        .timeline({ onComplete: settle })
        // no cracking: the paper simply slides up out of the envelope…
        .fromTo(letter, { yPercent: 22, scale: 0.72, opacity: 0 }, { opacity: 1, duration: 0.25, ease: 'none' }, 0.1)
        .to(letter, { yPercent: -10, scale: 0.8, duration: 0.7, ease: 'power2.out' }, 0.1)
        // …the envelope falls away, and the letter comes forward
        .to(env, { yPercent: 60, rotate: -10, opacity: 0, duration: 0.65, ease: 'power2.in' }, 0.5)
        .to(letter, { yPercent: 0, scale: 1, duration: 0.7, ease: 'power3.out', clearProps: 'transform,opacity' }, 0.65)
        .from(parts(), { y: 8, opacity: 0, duration: 0.35, stagger: 0.06, ease: 'power2.out', clearProps: 'transform,opacity' }, 1.0);
    };
    seal.onclick = open;
    form.querySelector<HTMLButtonElement>('[data-fold]')!.onclick = () => window.siteOverlay.close('letter');
    letter.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') window.siteOverlay.close('letter');
    });

    const check = (focusFirst: boolean) => {
      const bad: (keyof typeof fields)[] = [];
      if (!fields.name.value.trim()) bad.push('name');
      if (!EMAIL_RE.test(fields.email.value.trim())) bad.push('email');
      if (!fields.message.value.trim()) bad.push('message');
      (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) => {
        const isBad = bad.includes(k);
        fields[k].setAttribute('aria-invalid', String(isBad));
        form.querySelector<HTMLElement>(`#e-${k}`)!.hidden = !isBad;
      });
      if (focusFirst && bad[0]) fields[bad[0]].focus();
      return bad.length === 0;
    };
    Object.values(fields).forEach((f) => f.addEventListener('blur', () => attempted && check(false)));

    const setStatus = (kind: 'sending' | 'success' | 'error' | '', text: string) => {
      status.dataset.kind = kind;
      status.replaceChildren();
      const icon = document.querySelector<HTMLTemplateElement>(`#tea-icon-${kind}`);
      if (icon) status.append(icon.content.cloneNode(true));
      const span = document.createElement('span');
      span.textContent = text;
      status.append(span);
    };
    const setBusy = (b: boolean) => {
      busy = b;
      submit.disabled = b;
      submit.setAttribute('aria-busy', String(b));
      Object.values(fields).forEach((f) => (f.disabled = b));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return; // no double sends
      attempted = true;
      if (!check(true)) return;
      if (trap.value) {
        // Bot filled the honeypot: pretend all is well, send nothing.
        setStatus('success', copy.success);
        form.reset();
        return;
      }
      const data = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        message: fields.message.value.trim(),
      };
      if (mode === 'mailto') {
        setBusy(true);
        const subject = encodeURIComponent(`A letter from ${data.name}`);
        const body = encodeURIComponent(`${data.message}\n\n${data.name} (${data.email})`);
        window.location.href = `mailto:${copy.email}?subject=${subject}&body=${body}`;
        setStatus('success', copy.successMailto);
        window.setTimeout(() => setBusy(false), 2500);
        return;
      }
      setBusy(true);
      const label = submitLabel.textContent;
      submitLabel.textContent = copy.sending;
      setStatus('sending', copy.sending);
      const ctrl = new AbortController();
      const timeout = window.setTimeout(() => ctrl.abort(), 12000);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
          signal: ctrl.signal,
        });
        if (!res.ok) throw new Error(String(res.status));
        setStatus('success', copy.success);
        sfx('page');
        form.reset();
        attempted = false;
      } catch {
        setStatus('error', copy.error);
      } finally {
        window.clearTimeout(timeout);
        submitLabel.textContent = label;
        setBusy(false);
      }
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
