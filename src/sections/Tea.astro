---
import { chapters, site, tea } from '../content/site';
import Icon from '../components/Icon.astro';
import { Image, getImage } from 'astro:assets';
import { collage, design } from '../content/photos';

import TeaIcon from '../components/TeaIcon.astro';
const ch = chapters.find((c) => c.id === 'tea')!;
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() || '';
const mode = endpoint ? 'endpoint' : 'mailto';
const action = endpoint || `mailto:${site.email}`;
const paper = await getImage({ src: collage.paper, width: 900, format: 'webp', quality: 72 });
const gingham = await getImage({ src: design.gingham, width: 1800, format: 'webp', quality: 70 });
---

<!-- Layout follows Shiru's revised Canva "Tea at midnight" (gingham, icons, envelope). -->
<section id={ch.id} class="tea" data-tone="night" aria-labelledby="tea-title" style={`--gingham:url(${gingham.src})`}>
  <div class="tea__inner">
    <div class="tea__lead" data-effect="reveal" data-effect-options='{"type":"rise","targets":".tea__intro, .tea__links li","stagger":0.12,"delay":0.4}'>
      <h2 id="tea-title" class="tea__title" data-effect="ghost-title">{tea.title}</h2>
      <p class="tea__intro">{tea.intro}</p>
      <ul class="tea__links">
        {
          tea.links.map((l) => (
            <li>
              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined} target={l.href.startsWith('http') ? '_blank' : undefined}>
                <TeaIcon name={l.icon} />
                <span class="visually-hidden">{l.label}{l.href.startsWith('http') ? ' (opens in a new tab)' : ''}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="tea__table" data-effect="reveal" data-effect-options='{"type":"settle","targets":".envelope","start":"top 75%"}'>
      <div class="envelope" data-envelope data-mode={mode}>
        <Image class="envelope__img" src={collage.envelope} alt="" width={640} loading="lazy" decoding="async" />
        <button class="envelope__seal" type="button" data-seal aria-expanded="false" aria-controls="letter">
          <span class="visually-hidden">{tea.sealLabel}</span>
          <!-- the wax seal is in the watercolour; this draws the crack when it breaks -->
          <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <path class="seal__crack" d="M46 4l4 20-6 12 7 14-5 16 6 14-3 16" fill="none" stroke="#2b1215" stroke-width="3" stroke-linecap="round"></path>
            <path class="seal__crack" d="M50 50l18-6 14 4M48 66l-20 8" fill="none" stroke="#2b1215" stroke-width="2.4" stroke-linecap="round"></path>
          </svg>
        </button>
        <p class="envelope__hint label" data-hint="seal"><span aria-hidden="true">↑ </span>{tea.sealHint}</p>
      </div>

      <div class="letter" id="letter" data-tone="bone" data-letter style={`--paper:url(${paper.src})`}>
        <h3 class="letter__title" data-effect="wet-ink">{tea.formTitle}</h3>
        <form class="letter__form" action={action} method="post" enctype={mode === 'mailto' ? 'text/plain' : undefined} novalidate data-form>
          <div class="field">
            <label for="f-name">{tea.fields.name.label}</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
            <p class="field__error" id="e-name" hidden><Icon name="warn" size={18} /><span>{tea.fields.name.error}</span></p>
          </div>
          <div class="field">
            <label for="f-email">{tea.fields.email.label}</label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="e-email" />
            <p class="field__error" id="e-email" hidden><Icon name="warn" size={18} /><span>{tea.fields.email.error}</span></p>
          </div>
          <div class="field">
            <label for="f-message">{tea.fields.message.label}</label>
            <textarea id="f-message" name="message" rows="5" required minlength="10" aria-describedby="e-message"></textarea>
            <p class="field__error" id="e-message" hidden><Icon name="warn" size={18} /><span>{tea.fields.message.error}</span></p>
          </div>
          <div class="field field--trap" aria-hidden="true">
            <label for="f-website">{tea.fields.honeypot}</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="letter__actions">
            <button class="btn btn--solid" type="submit" data-submit>
              <Icon name="quill" size={18} />
              <span data-submit-label>{mode === 'mailto' ? tea.submitMailto : tea.submit}</span>
            </button>
            <button class="btn letter__fold" type="button" data-fold>{tea.closeEnvelope}</button>
          </div>
          <div class="letter__status" role="status" aria-live="polite" data-status></div>
        </form>
      </div>
    </div>

  </div>
</section>

<script
  is:inline
  type="application/json"
  id="tea-copy"
  set:html={JSON.stringify({
    sending: tea.sending,
    success: tea.success,
    successMailto: tea.successMailto,
    error: tea.error(site.email),
    email: site.email,
  })}
></script>
<template id="tea-icon-error"><Icon name="warn" size={20} /></template>
<template id="tea-icon-success"><Icon name="check" size={20} /></template>

<style>
  .tea {
    position: relative;
    padding: clamp(5rem, 9vw, 7.5rem) var(--gutter) clamp(5rem, 9vw, 8rem);
    background: var(--gingham) center / cover no-repeat, #1b1a1c;
    color: var(--bone);
    overflow-x: clip;
  }
  .tea__inner {
    position: relative;
    z-index: var(--z-content);
    max-width: 72rem;
    margin-inline: auto;
    display: grid;
    gap: var(--space-6);
  }
  .tea__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 3.6vw, 5.6rem);
    line-height: 0.9;
    color: #f4efe4;
    max-width: 8ch;
    /* the soft dark halo from the design keeps it legible on the gingham */
    text-shadow:
      0 0 18px rgb(5 3 4 / 0.95),
      0 0 42px rgb(5 3 4 / 0.8);
  }
  .tea__intro {
    margin-top: var(--space-4);
    max-width: 30ch;
    font-style: italic;
    color: #f4efe4;
    text-shadow:
      0 0 6px rgb(5 3 4 / 1),
      0 0 16px rgb(5 3 4 / 0.95),
      0 0 30px rgb(5 3 4 / 0.8);
  }
  .tea__links {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }
  .tea__links {
    gap: var(--space-4);
  }
  .tea__links a {
    display: inline-grid;
    place-items: center;
    width: 76px;
    height: 76px;
    color: #f4efe4;
    filter: drop-shadow(0 0 6px rgb(5 3 4 / 0.95)) drop-shadow(0 0 14px rgb(5 3 4 / 0.7));
    transition: transform var(--dur-quick) var(--ease-out);
  }
  .tea__links a :global(svg) {
    width: 62px;
    height: 62px;
  }
  .tea__links a:hover,
  .tea__links a:focus-visible {
    transform: translateY(-4px) rotate(-6deg);
  }
  .tea__table {
    position: relative;
    display: grid;
    justify-items: center;
    padding-bottom: var(--space-6);
  }

  /* ---- envelope (watercolour cut-out; the seal button sits on its wax seal) ---- */
  .envelope {
    position: relative;
    width: min(100%, 32rem);
    aspect-ratio: 766 / 638;
    transform: rotate(-3deg);
    transition:
      transform 900ms var(--ease-ink) 300ms,
      opacity 900ms var(--ease-ink) 300ms;
  }
  .envelope__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(10px 14px 0 rgb(5 3 4 / 0.55));
  }
  /* opened: the envelope slips away and the letter takes its place (as in the design) */
  .envelope.is-open {
    position: absolute;
    top: 0;
    transform: rotate(-12deg) translateY(30%) scale(0.8);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 700ms var(--ease-ink) 250ms,
      opacity 500ms var(--ease-ink) 350ms,
      visibility 0s 900ms;
  }
  .envelope__seal {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 57.7%;
    width: 22%;
    aspect-ratio: 1;
    min-width: var(--touch);
    translate: -50% -50%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transition: transform var(--dur-quick) var(--ease-out), box-shadow var(--dur-base);
  }
  .envelope__seal:hover {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 0 0 3px rgb(232 220 194 / 0.35), 0 0 28px 6px rgb(163 20 27 / 0.35);
  }
  .envelope__seal:active {
    transform: scale(0.96);
  }
  .envelope__seal:focus-visible {
    outline-color: var(--bone);
    box-shadow: 0 0 0 6px var(--night);
  }
  .envelope__seal svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .seal__crack {
    stroke-dasharray: 140;
    stroke-dashoffset: 140;
    transition: stroke-dashoffset 380ms var(--ease-drop);
  }
  .envelope.is-open .seal__crack {
    stroke-dashoffset: 0;
  }
  .envelope.is-open .envelope__seal {
    pointer-events: none;
  }
  .envelope__hint {
    position: absolute;
    left: 50%;
    top: calc(100% + var(--space-2));
    translate: -50% 0;
    max-width: 9ch;
    text-align: center;
    color: #f4efe4;
    font-size: 0.95rem;
    text-shadow:
      0 0 6px rgb(5 3 4 / 1),
      0 0 16px rgb(5 3 4 / 0.9);
    animation: hint-sway 2.4s var(--ease-ink) infinite;
  }
  @keyframes hint-sway {
    50% {
      translate: -50% -4px;
    }
  }

  /* ---- the letter (form) ---- */
  /* the torn sheet is the letter paper; extra padding keeps text off the ragged edges */
  .letter {
    position: relative;
    z-index: 2;
    width: min(100%, 34rem);
    margin-top: -55%;
    padding: 13% 9% 10%;
    background: var(--paper) center / 100% 100% no-repeat;
    filter: drop-shadow(10px 14px 0 rgb(5 3 4 / 0.5));
    transform: rotate(1deg);
  }
  :global(html.js) .letter {
    display: none;
  }
  :global(html.js) .envelope.is-open + .letter {
    display: block;
    margin-top: 0;
    animation: letter-out 800ms var(--ease-out) 350ms both;
  }
  :global(html:not(.js)) .letter {
    margin-top: var(--space-4);
  }
  :global(html:not(.js)) .envelope__seal,
  :global(html:not(.js)) .envelope__hint {
    display: none;
  }
  @keyframes letter-out {
    from {
      transform: translateY(30%) rotate(1deg);
      opacity: 0;
      clip-path: inset(0 0 60% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .letter__title {
    font-family: var(--font-body);
    font-size: var(--step-2);
    margin-bottom: var(--space-3);
    color: var(--ink);
  }
  .letter__form {
    display: grid;
    gap: var(--space-3);
  }
  .field {
    display: grid;
    gap: var(--space-half);
  }
  .field label {
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: var(--touch);
    padding: var(--space-1) var(--space-1);
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: rgb(255 250 235 / 0.35);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--step-0);
    border-radius: 0;
  }
  .field textarea {
    resize: vertical;
    background-image: repeating-linear-gradient(transparent 0 1.6em, rgb(42 26 18 / 0.15) 1.6em calc(1.6em + 1px));
    line-height: 1.6;
  }
  .field input:hover,
  .field textarea:hover {
    background-color: rgb(255 250 235 / 0.55);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--blood);
    outline-offset: 2px;
    box-shadow: none;
  }
  .field [aria-invalid='true'] {
    border-bottom: 2px solid var(--error);
  }
  .field input:disabled,
  .field textarea:disabled {
    opacity: 0.6;
  }
  .field__error {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    color: var(--error);
    font-size: var(--text-small);
  }
  .field__error[hidden] {
    display: none;
  }
  .field--trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .letter__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  :global(html:not(.js)) .letter__fold {
    display: none;
  }
  .letter__status:empty {
    display: none;
  }
  .letter__status {
    display: flex;
    gap: var(--space-1);
    align-items: flex-start;
    padding: var(--space-2);
    border: 1px solid currentColor;
  }
  .letter__status[data-kind='success'] {
    color: var(--success);
  }
  .letter__status[data-kind='error'] {
    color: var(--error);
  }
  .letter__status[data-kind='sending'] {
    color: var(--fg-muted);
  }

  @media (min-width: 900px) {
    .tea__inner {
      grid-template-columns: 4fr 7fr;
      align-items: start;
    }
    .tea__table {
      grid-column: 2;
    }
  }
</style>

<script>
  import { markHintUsed } from '../lib/hints';
  import { sfx } from '../lib/sfx';

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function bind() {
    const env = document.querySelector<HTMLElement>('[data-envelope]');
    const seal = document.querySelector<HTMLButtonElement>('[data-seal]');
    const letter = document.querySelector<HTMLElement>('[data-letter]');
    const form = document.querySelector<HTMLFormElement>('[data-form]');
    const copyEl = document.getElementById('tea-copy');
    if (!env || !seal || !letter || !form || !copyEl) return;
    const copy = JSON.parse(copyEl.textContent ?? '{}') as {
      sending: string;
      success: string;
      successMailto: string;
      error: string;
      email: string;
    };
    const mode = env.dataset.mode;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const fields = {
      name: form.querySelector<HTMLInputElement>('#f-name')!,
      email: form.querySelector<HTMLInputElement>('#f-email')!,
      message: form.querySelector<HTMLTextAreaElement>('#f-message')!,
    };
    const trap = form.querySelector<HTMLInputElement>('#f-website')!;
    let attempted = false;
    let busy = false;

    const close = () => {
      env.classList.remove('is-open');
      seal.setAttribute('aria-expanded', 'false');
      seal.focus();
    };
    const open = () => {
      if (env.classList.contains('is-open')) return;
      env.classList.add('is-open');
      seal.setAttribute('aria-expanded', 'true');
      markHintUsed('seal');
      sfx('seal');
      window.shiruOverlay.open('letter', close);
      window.setTimeout(() => fields.name.focus({ preventScroll: true }), 900);
    };
    seal.onclick = open;
    form.querySelector<HTMLButtonElement>('[data-fold]')!.onclick = () => window.shiruOverlay.close('letter');
    letter.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') window.shiruOverlay.close('letter');
    });

    const check = (focusFirst: boolean) => {
      const bad: (keyof typeof fields)[] = [];
      if (!fields.name.value.trim()) bad.push('name');
      if (!EMAIL_RE.test(fields.email.value.trim())) bad.push('email');
      if (fields.message.value.trim().length < 10) bad.push('message');
      (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) => {
        const isBad = bad.includes(k);
        fields[k].setAttribute('aria-invalid', String(isBad));
        form.querySelector<HTMLElement>(`#e-${k}`)!.hidden = !isBad;
      });
      if (focusFirst && bad[0]) fields[bad[0]].focus();
      return bad.length === 0;
    };
    Object.values(fields).forEach((f) => f.addEventListener('blur', () => attempted && check(false)));

    const setStatus = (kind: 'sending' | 'success' | 'error' | '', text: string) => {
      status.dataset.kind = kind;
      status.replaceChildren();
      const icon = document.querySelector<HTMLTemplateElement>(`#tea-icon-${kind}`);
      if (icon) status.append(icon.content.cloneNode(true));
      const span = document.createElement('span');
      span.textContent = text;
      status.append(span);
    };
    const setBusy = (b: boolean) => {
      busy = b;
      submit.disabled = b;
      submit.setAttribute('aria-busy', String(b));
      Object.values(fields).forEach((f) => (f.disabled = b));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return; // no double sends
      attempted = true;
      if (!check(true)) return;
      if (trap.value) {
        // Bot filled the honeypot: pretend all is well, send nothing.
        setStatus('success', copy.success);
        form.reset();
        return;
      }
      const data = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        message: fields.message.value.trim(),
      };
      if (mode === 'mailto') {
        setBusy(true);
        const subject = encodeURIComponent(`A letter from ${data.name}`);
        const body = encodeURIComponent(`${data.message}\n\n${data.name} (${data.email})`);
        window.location.href = `mailto:${copy.email}?subject=${subject}&body=${body}`;
        setStatus('success', copy.successMailto);
        window.setTimeout(() => setBusy(false), 2500);
        return;
      }
      setBusy(true);
      const label = submitLabel.textContent;
      submitLabel.textContent = copy.sending;
      setStatus('sending', copy.sending);
      const ctrl = new AbortController();
      const timeout = window.setTimeout(() => ctrl.abort(), 12000);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
          signal: ctrl.signal,
        });
        if (!res.ok) throw new Error(String(res.status));
        setStatus('success', copy.success);
        sfx('page');
        form.reset();
        attempted = false;
      } catch {
        setStatus('error', copy.error);
      } finally {
        window.clearTimeout(timeout);
        submitLabel.textContent = label;
        setBusy(false);
      }
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
