---
import { Image, getImage } from 'astro:assets';
import { about, chapters, ui } from '../content/site';
import { collage, design } from '../content/photos';
import SectionHead from '../components/SectionHead.astro';

const ch = chapters.find((c) => c.id === 'rabbit-hole')!;
const lace = await getImage({ src: design.lace, width: 960, format: 'webp', quality: 80 });
---

<section id={ch.id} class="section about" data-tone="void" aria-labelledby="about-title">
  <div class="container">
    <SectionHead id="about-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={about.title} lead={about.card} />

    <div class="about__grid">
      <figure class="lace" style={`--lace:url(${lace.src})`} data-effect="reveal" data-effect-options='{"type":"settle"}'>
        <span class="lace__specimen">
          <Image class="lace__moth" src={collage.moth} alt={about.sweetAlt} widths={[240, 480]} sizes="14rem" loading="lazy" decoding="async" />
          <span class="lace__pin" aria-hidden="true"></span>
        </span>
        <figcaption class="lace__caption">{about.sweet}</figcaption>
      </figure>

      <div class="about__text">
        <div class="body-copy" data-effect="reveal" data-effect-options='{"type":"rise","targets":"p","stagger":0.15}'>
          {about.body.map((p) => <p>{p}</p>)}
        </div>

        <dl class="facts about__facts" data-effect="reveal" data-effect-options='{"type":"rise","targets":".facts__row","stagger":0.1}'>
          {
            about.facts.map((f) => (
              <div class="facts__row">
                <dt>{f.term}</dt>
                <dd>
                  {f.href ? (
                    <a href={f.href} rel="me noopener" target="_blank">
                      {f.detail} <span aria-hidden="true">↗</span>
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  ) : (
                    f.detail
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="about__warning" data-effect="flicker-jitter" data-effect-options='{"every":[5,11],"jitter":false}'>{about.warning}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  /* the lace frame: a gothic doily on black, holding one pinned specimen */
  .lace {
    position: relative;
    isolation: isolate;
    justify-self: start;
    width: min(100%, 26rem);
    aspect-ratio: 960 / 1378;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    gap: var(--space-3);
    padding: 22% 20%;
    margin: 0;
  }
  /* the doily, lifted from near-black to a pale grey so it reads on the dark page */
  .lace::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--lace) center / 100% 100% no-repeat;
    filter: brightness(5.5) sepia(0.25);
  }
  .lace__specimen {
    position: relative;
    display: block;
    width: 78%;
  }
  .lace__moth {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.35) contrast(1.05) drop-shadow(0 10px 12px rgb(0 0 0 / 0.6));
    transform-origin: 50% 40%;
    /* mostly still, as a pinned thing should be; then a wing twitch it shouldn't be able to do */
    animation: moth-twitch 9s steps(1, end) infinite;
  }
  /* the pin through its body */
  .lace__pin {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 2px;
    height: 34%;
    translate: -50% 0;
    background: linear-gradient(#cfc6b3, #6f685c);
    rotate: 8deg;
    transform-origin: 50% 0;
  }
  .lace__pin::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -5px;
    width: 9px;
    height: 9px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #e5434a, #6b0c11 70%);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.6);
  }
  @keyframes moth-twitch {
    0%,
    82% {
      scale: 1 1;
    }
    83% {
      scale: 0.86 1;
    }
    84% {
      scale: 1 1;
    }
    85.5% {
      scale: 0.9 1;
    }
    86.5%,
    100% {
      scale: 1 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lace__moth {
      animation: none;
    }
  }
  .lace__caption {
    font-style: italic;
    font-size: var(--text-small);
    line-height: 1.5;
    text-align: center;
    color: var(--bone);
    max-width: 16ch;
  }

  .about__facts {
    margin-top: var(--space-6);
  }
  .about__facts a {
    color: var(--bone);
  }
  .about__warning {
    margin-top: var(--space-4);
    font-style: italic;
    color: var(--muted);
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
  @media (max-width: 959px) {
    .lace {
      justify-self: center;
    }
  }
</style>
