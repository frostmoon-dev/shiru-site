---
import { Image, getImage } from 'astro:assets';
import { about, chapters, ui } from '../content/site';
import { collage, cutouts, design } from '../content/photos';
import SectionHead from '../components/SectionHead.astro';

const ch = chapters.find((c) => c.id === 'rabbit-hole')!;
const lace = await getImage({ src: design.lace, width: 960, format: 'webp', quality: 80 });
---

<section id={ch.id} class="section about" data-tone="void" aria-labelledby="about-title" data-effect="fall-parallax">
  <!-- falling down the hole: things drift up past you at different depths as you scroll -->
  <div class="fall" aria-hidden="true">
    <div class="fall__tunnel" data-fall-zoom></div>
    <span class="fall__item fall__item--watch" data-depth="0.9" data-spin="140"><Image src={design.pocketWatch} alt="" width={220} loading="lazy" decoding="async" /></span>
    <span class="fall__item fall__item--keyhole" data-depth="0.5" data-spin="-60"><Image src={cutouts.keyhole} alt="" width={120} loading="lazy" decoding="async" /></span>
    <span class="fall__item fall__item--mirror" data-depth="1.2" data-spin="40"><Image src={cutouts.mirror} alt="" width={200} loading="lazy" decoding="async" /></span>
    <span class="fall__item fall__item--book" data-depth="0.7" data-spin="-110"><Image src={cutouts.openBook} alt="" width={240} loading="lazy" decoding="async" /></span>
    <span class="fall__item fall__item--card" data-depth="1.4" data-spin="220"><span>Q<br />♥</span></span>
  </div>
  <div class="container">
    <SectionHead id="about-title" kicker={ui.caseNo(ch.numeral, ch.label)} title={about.title} lead={about.card} />

    <div class="about__grid">
      <figure class="lace" style={`--lace:url(${lace.src})`} data-effect="reveal" data-effect-options='{"type":"settle"}'>
        <span class="lace__specimen">
          <Image class="lace__moth" src={collage.moth} alt={about.sweetAlt} widths={[240, 480]} sizes="14rem" loading="lazy" decoding="async" />
          <span class="lace__pin" aria-hidden="true"></span>
        </span>
        <figcaption class="lace__caption">{about.sweet}</figcaption>
      </figure>

      <div class="about__text">
        <div class="body-copy" data-effect="reveal" data-effect-options='{"type":"rise","targets":"p","stagger":0.15}'>
          {about.body.map((p) => <p>{p}</p>)}
        </div>

        <dl class="facts about__facts" data-effect="reveal" data-effect-options='{"type":"rise","targets":".facts__row","stagger":0.1}'>
          {
            about.facts.map((f) => (
              <div class="facts__row">
                <dt>{f.term}</dt>
                <dd>
                  {f.href?.startsWith('http') ? (
                    <a href={f.href} rel="me noopener" target="_blank">
                      {f.detail} <span aria-hidden="true">↗</span>
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  ) : f.href ? (
                    <a href={f.href}>
                      {f.detail} <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    f.detail
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="about__warning" data-effect="flicker-jitter" data-effect-options='{"every":[5,11],"jitter":false}'>{about.warning}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    isolation: isolate;
    overflow: hidden;
  }
  .about > .container {
    position: relative;
    z-index: 2;
  }
  /* ---- the fall ---- */
  .fall {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* rings of the hole, very faint, opening as you fall in */
  .fall__tunnel {
    position: absolute;
    inset: -10% -20%;
    background: repeating-radial-gradient(ellipse at 50% 55%, transparent 0 46px, rgb(232 220 194 / 0.035) 46px 48px);
    mask-image: radial-gradient(ellipse at 50% 55%, #000 25%, transparent 70%);
  }
  .fall__item {
    position: absolute;
    display: block;
    opacity: 0.8;
  }
  .fall__item :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(0.35) brightness(0.8);
  }
  /* near things are big and soft, far things small and sharp */
  .fall__item--watch {
    left: 2%;
    top: 58%;
    width: clamp(90px, 10vw, 160px);
  }
  .fall__item--keyhole {
    right: 6%;
    top: 22%;
    width: clamp(40px, 4vw, 64px);
    opacity: 0.55;
  }
  .fall__item--mirror {
    right: 1%;
    top: 70%;
    width: clamp(90px, 11vw, 170px);
    filter: blur(1.5px);
  }
  .fall__item--book {
    left: 38%;
    top: 92%;
    width: clamp(100px, 12vw, 190px);
    opacity: 0.5;
    filter: blur(0.6px);
  }
  .fall__item--card {
    right: 3%;
    top: 40%;
    width: clamp(46px, 4.5vw, 70px);
    aspect-ratio: 5 / 7;
    display: grid;
    place-items: start;
    padding: 6px;
    border-radius: 6px;
    background: #f3ead6;
    color: #a3141b;
    font-family: Georgia, serif;
    font-size: 0.85rem;
    line-height: 1;
    filter: blur(2px);
    opacity: 0.6;
  }
  @media (max-width: 719px) {
    /* phones have no margins to fall through: only the watch and the keyhole, at the edges */
    .fall__item--mirror,
    .fall__item--book,
    .fall__item--card {
      display: none;
    }
    .fall__item--keyhole {
      right: 2%;
      top: 70%;
    }
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  /* the lace frame: a gothic doily on black, holding one pinned specimen */
  .lace {
    position: relative;
    isolation: isolate;
    justify-self: start;
    width: min(100%, 26rem);
    aspect-ratio: 960 / 1378;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    gap: var(--space-3);
    padding: 22% 20%;
    margin: 0;
  }
  /* the doily, lifted from near-black to a pale grey so it reads on the dark page */
  .lace::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--lace) center / 100% 100% no-repeat;
    filter: brightness(5.5) sepia(0.25);
  }
  .lace__specimen {
    position: relative;
    display: block;
    width: 78%;
  }
  .lace__moth {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.35) contrast(1.05) drop-shadow(0 10px 12px rgb(0 0 0 / 0.6));
    transform-origin: 50% 40%;
    /* mostly still, as a pinned thing should be; then a wing twitch it shouldn't be able to do */
    animation: moth-twitch 9s steps(1, end) infinite;
  }
  /* the pin through its body */
  .lace__pin {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 2px;
    height: 34%;
    translate: -50% 0;
    background: linear-gradient(#cfc6b3, #6f685c);
    rotate: 8deg;
    transform-origin: 50% 0;
  }
  .lace__pin::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -5px;
    width: 9px;
    height: 9px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #e5434a, #6b0c11 70%);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.6);
  }
  @keyframes moth-twitch {
    0%,
    82% {
      scale: 1 1;
    }
    83% {
      scale: 0.86 1;
    }
    84% {
      scale: 1 1;
    }
    85.5% {
      scale: 0.9 1;
    }
    86.5%,
    100% {
      scale: 1 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lace__moth {
      animation: none;
    }
  }
  .lace__caption {
    font-style: italic;
    font-size: var(--text-small);
    line-height: 1.5;
    text-align: center;
    color: var(--bone);
    max-width: 16ch;
  }

  .about__facts {
    margin-top: var(--space-6);
  }
  .about__facts a {
    color: var(--bone);
  }
  .about__warning {
    margin-top: var(--space-4);
    font-style: italic;
    color: var(--muted);
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
  @media (max-width: 959px) {
    .lace {
      justify-self: center;
    }
  }
</style>
