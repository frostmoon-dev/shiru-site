---
import { Picture } from 'astro:assets';
import { hero, ui } from '../content/site';
import { heroPortrait } from '../content/photos';
import InkEdgeFallback from '../components/scene/InkEdgeFallback.astro';
import Icon from '../components/Icon.astro';
---

<section id="top" class="hero" data-tone="void" aria-labelledby="hero-title">
  <!-- Someone is standing in the dark. You only see what the light touches. -->
  <div class="hero__portrait" aria-hidden="true" data-effect="lantern-reveal">
    <Picture
      src={heroPortrait}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(max-width: 719px) 100vw, 60vw"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="hero__content" data-effect="flicker-jitter" data-effect-options='{"every":[9,20]}'>
    <p class="hero__kicker label">{hero.kicker}</p>
    <h1 id="hero-title" class="hero__title" data-effect="ghost-title" data-effect-options='{"every":[6,14]}'>{hero.name}</h1>
    <span class="hero__rule" aria-hidden="true"></span>
    <p class="hero__tagline label">{hero.tagline}</p>
    <p class="hero__sub">{hero.sub}</p>
  </div>

  <a class="hero__scroll label" href="#rabbit-hole">
    {ui.scrollHint}
    <Icon name="arrow-down" size={20} />
  </a>

  <div class="ink-edge" aria-hidden="true" data-effect="ink-edge" data-effect-options='{"rest":0.18}'>
    <InkEdgeFallback rest={0.18} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding: var(--space-8) var(--gutter) calc(var(--space-7) + 6vh);
    background:
      radial-gradient(ellipse 60% 50% at 70% 35%, rgb(26 25 34 / 0.55), transparent 70%),
      var(--void);
  }

  /* The hidden portrait: barely there everywhere, uncovered where the lantern points. */
  .hero__portrait {
    --lx: 58%;
    --ly: 34%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(64vw, 980px);
    pointer-events: none;
    -webkit-mask-image:
      radial-gradient(circle at var(--lx) var(--ly), #000 0, rgb(0 0 0 / 0.55) 11%, transparent 30%),
      linear-gradient(rgb(0 0 0 / 0.07), rgb(0 0 0 / 0.07));
    mask-image:
      radial-gradient(circle at var(--lx) var(--ly), #000 0, rgb(0 0 0 / 0.55) 11%, transparent 30%),
      linear-gradient(rgb(0 0 0 / 0.07), rgb(0 0 0 / 0.07));
  }
  .hero__portrait :global(picture),
  .hero__portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: grayscale(1) contrast(1.15) brightness(0.85);
  }
  .hero__portrait::after {
    /* melt the left edge into the dark */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--void), transparent 35%, transparent 85%, var(--void));
  }
  @property --lx {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 58%;
  }
  @property --ly {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 34%;
  }
  .hero__portrait:global(.is-drifting) {
    animation: lantern-drift 23s ease-in-out infinite alternate;
  }
  @keyframes lantern-drift {
    0% {
      --lx: 58%;
      --ly: 30%;
    }
    35% {
      --lx: 44%;
      --ly: 42%;
    }
    70% {
      --lx: 66%;
      --ly: 50%;
    }
    100% {
      --lx: 52%;
      --ly: 24%;
    }
  }

  .hero__content {
    position: relative;
    z-index: var(--z-content);
    max-width: 52rem;
    margin-left: clamp(0rem, 3vw, 4rem);
  }
  .hero__kicker {
    color: var(--muted);
    margin-bottom: var(--space-2);
  }
  .hero__title {
    font-family: var(--font-hero);
    font-size: var(--step-6);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: var(--bone);
    text-transform: uppercase;
    margin-left: -0.04em;
  }
  .hero__rule {
    display: block;
    width: 3.5rem;
    height: 2px;
    margin-block: var(--space-4) var(--space-3);
    background: var(--blood);
  }
  .hero__tagline {
    color: var(--bone);
    font-size: clamp(var(--text-label), 0.7rem + 0.4vw, 0.95rem);
    max-width: 44ch;
  }
  .hero__sub {
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: var(--step-0);
    max-width: 44ch;
  }
  .hero__scroll {
    position: absolute;
    z-index: var(--z-content);
    left: var(--gutter);
    top: calc(var(--space-2) + var(--touch) + var(--space-3));
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch);
    padding-inline: var(--space-1);
    color: var(--muted);
    text-decoration: none;
  }
  .hero__scroll:hover {
    color: var(--bone);
  }
  .hero__scroll :global(.icon) {
    animation: nudge 2.4s var(--ease-ink) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }

  .ink-edge {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - 8vh);
    height: 45vh;
    z-index: var(--z-webgl);
    pointer-events: none;
  }
  .ink-edge[data-webgl='on'] :global(.ink-fallback) {
    visibility: hidden;
  }

  @media (max-width: 719px) {
    .hero {
      padding-bottom: calc(var(--space-7) + 10vh);
    }
    .hero__portrait {
      width: 100%;
      opacity: 0.85;
    }
    .hero__content {
      margin-left: 0;
    }
    .hero__scroll {
      top: auto;
      bottom: calc(10vh + var(--space-3));
    }
  }
</style>
