---
import { Image } from 'astro:assets';
import { hero, work } from '../content/site';
import { collage } from '../content/photos';
---

<!--
  Layout follows Teha's revised Canva hero (1440 × 900). Nothing here that isn't in that design.
  The eye + "Navigate." (bottom right) is the menu button; it lives in SiteNav.
-->
<section id="top" class="hero" data-tone="void" aria-labelledby="hero-title" data-effect="hero-entrance" data-effect-priority="high">
  <!-- leaving the hero: an iris-out, like the end of an old film -->
  <span class="passage" data-effect="passage" data-effect-options='{"type":"iris"}' aria-hidden="true"></span>
  <div class="hero__collage" aria-hidden="true">
    <Image
      class="hero__newspaper"
      src={collage.newspaper}
      alt=""
      widths={[320, 520, 760, 1000]}
      sizes="(max-width: 899px) 52vw, min(34.5vw, 620px)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <span class="hero__hand-wrap" data-enter>
      <Image class="hero__hand" src={collage.hand} alt="" width={460} loading="eager" decoding="async" />
    </span>
  </div>

  <div class="hero__content container">
    <p class="hero__kicker kicker" data-enter>{hero.kicker}</p>
    <h1 id="hero-title" class="hero__title display-1">{hero.name}</h1>
    <p
      class="hero__lines"
      data-effect="typewriter"
      data-effect-priority="high"
      data-effect-options='{"speed":65,"waitForIntro":true,"delay":900}'
      data-type-early
    >
      {hero.lines.map((l) => <span class="hero__line">{l}</span>)}
    </p>
    <p class="hero__tagline" data-enter>
      {hero.tagline.before}<em class="glitch"
        ><span class="glitch__base">{hero.tagline.glitch}</span><span class="glitch__layer glitch__layer--a" aria-hidden="true"
          >{hero.tagline.glitch}</span
        ><span class="glitch__layer glitch__layer--b" aria-hidden="true">{hero.tagline.glitch}</span></em
      >{hero.tagline.after}
    </p>
    <p class="hero__cta" data-enter>
      <a class="btn hero__work" href="/work/">{work.cta} <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--void);
    overflow-x: clip;
    /* the iris: wide open (130%) until the passage effect starts closing it */
    mask-image: radial-gradient(circle farthest-corner at 50% var(--iris-y, 42%), #000 calc(var(--iris, 130%) - 1.2%), transparent var(--iris, 130%));
  }

  /* ---- collage (positions measured from the 1440 × 900 Canva frame) ---- */
  .hero__collage {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    pointer-events: none;
  }
  .hero__newspaper {
    position: absolute;
    top: 0;
    right: 0;
    width: min(34.5vw, 620px);
    height: auto;
  }
  /* waits half out of frame (never transparent, so it still counts as painted for LCP) */
  :global(html.js.at-hero:not(.hero-entered)) .hero__newspaper,
  :global(html.js.intro-pending) .hero__newspaper {
    transform: translate(35%, -35%) rotate(8deg);
  }
  .hero__hand-wrap {
    position: absolute;
    left: 0;
    bottom: -6%;
    width: clamp(120px, 15.5vw, 250px);
  }
  .hero__hand {
    width: 100%;
    height: auto;
    filter: brightness(0.42);
    transform-origin: 10% 100%;
    animation: hand-reach 9s var(--ease-ink) infinite;
  }
  /* almost moves: the hand leans in a degree or two, then thinks better of it */
  @keyframes hand-reach {
    0%,
    100% {
      rotate: 0deg;
      translate: 0 0;
    }
    55% {
      rotate: 2deg;
      translate: 4px -6px;
    }
  }

  /* ---- text: on the same column as every section below ---- */
  .hero {
    display: flex;
    align-items: center;
  }
  .hero__content {
    position: relative;
    z-index: var(--z-content);
    padding-block: var(--space-8) var(--space-7);
  }
  .hero__content > * {
    max-width: 38rem;
  }
  .hero__title {
    margin-top: var(--space-5);
    max-width: none;
    /* four letters: the name can carry real size */
    font-size: clamp(5rem, 2rem + 10vw, 11rem);
    color: var(--bone);
    white-space: nowrap;
  }
  .hero__lines {
    margin-top: var(--space-6);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.5;
    letter-spacing: 0.12em;
    color: var(--bone);
    white-space: pre-line;
    min-height: 4.5em;
  }
  .hero__line {
    display: block;
  }
  :global(html.js) .hero__lines[data-type-early] {
    visibility: hidden;
  }
  .hero__tagline {
    margin-top: var(--space-4);
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--muted);
  }
  .hero__tagline .glitch {
    font-weight: 700;
  }
  .hero__cta {
    margin-top: var(--space-5);
  }
  .hero__work {
    position: relative;
    z-index: 1;
    color: var(--bone);
    border-color: var(--line);
    /* solid, so the hand cut-out never shows through the words */
    background: var(--void);
  }
  .hero__work:hover,
  .hero__work:focus-visible {
    border-color: var(--bone);
  }

  /* hidden until hero-entrance animates them in; fail-safe shows them after 8 s regardless */
  :global(html.js.at-hero:not(.hero-entered) [data-enter]),
  :global(html.js.intro-pending [data-enter]) {
    opacity: 0;
    animation: enter-failsafe 0.01s 8s forwards;
  }
  @keyframes enter-failsafe {
    to {
      opacity: 1;
    }
  }

  /* ---- glitch: "keeps me awake" slips out of register now and then ---- */
  .glitch {
    position: relative;
    display: inline-block;
    font-style: italic;
  }
  .glitch__layer {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    white-space: nowrap;
  }
  .glitch__layer--a {
    color: #e5434a;
    animation: glitch-a 4.2s steps(1, end) infinite;
  }
  .glitch__layer--b {
    color: var(--moon);
    animation: glitch-b 4.2s steps(1, end) infinite;
  }
  .glitch__base {
    display: inline-block;
    animation: glitch-base 4.2s steps(1, end) infinite;
  }
  /* each burst is ~250 ms out of 4.2 s: well under 3 flashes a second */
  /* layers are shown and hidden with clip-path (never half-transparent, so contrast holds) */
  @keyframes glitch-a {
    0%,
    86% {
      transform: none;
      clip-path: inset(0 0 100% 0);
    }
    87% {
      transform: translate(-3px, 1px);
      clip-path: inset(10% 0 55% 0);
    }
    89% {
      transform: translate(4px, -1px);
      clip-path: inset(60% 0 8% 0);
    }
    91% {
      transform: translate(-2px, 0);
      clip-path: inset(35% 0 35% 0);
    }
    93%,
    100% {
      transform: none;
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes glitch-b {
    0%,
    86% {
      transform: none;
      clip-path: inset(0 0 100% 0);
    }
    88% {
      transform: translate(3px, 0);
      clip-path: inset(45% 0 20% 0);
    }
    90% {
      transform: translate(-4px, 1px);
      clip-path: inset(5% 0 70% 0);
    }
    92%,
    100% {
      transform: none;
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes glitch-base {
    0%,
    86% {
      transform: none;
    }
    88% {
      transform: skewX(-8deg) translateX(2px);
    }
    90% {
      transform: translateX(-2px);
    }
    92%,
    100% {
      transform: none;
    }
  }


  @media (max-width: 899px) {
    .hero__newspaper {
      width: 56vw;
    }
    .hero__title {
      font-size: clamp(5rem, 26vw, 8rem);
    }
  }
</style>
