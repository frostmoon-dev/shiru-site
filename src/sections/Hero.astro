---
import { Image } from 'astro:assets';
import { hero } from '../content/site';
import { collage } from '../content/photos';
import InkEdgeFallback from '../components/scene/InkEdgeFallback.astro';
---

<!--
  Layout follows Shiru's Canva hero (1440 × 900 frame). Nothing here that isn't in that design.
  The paperclip + "For whom do you weep?" (bottom right) is the menu button; it lives in SiteNav.
-->
<section id="top" class="hero" data-tone="void" aria-labelledby="hero-title">
  <div class="hero__collage" aria-hidden="true">
    <Image
      class="hero__newspaper"
      src={collage.newspaper}
      alt=""
      widths={[320, 520, 760, 1000]}
      sizes="(max-width: 899px) 52vw, min(34.5vw, 620px)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <Image class="hero__eye" src={collage.eye} alt="" widths={[180, 330]} sizes="clamp(90px, 11.2vw, 190px)" loading="eager" decoding="async" />
    <Image class="hero__moth" src={collage.butterfly} alt="" width={280} loading="lazy" decoding="async" />
    <Image class="hero__hand" src={collage.hand} alt="" width={460} loading="lazy" decoding="async" />
  </div>

  <a class="hero__proceed label" href="#rabbit-hole">{hero.proceed}</a>

  <div class="hero__content">
    <p class="hero__kicker label">{hero.kicker}</p>
    <h1 id="hero-title" class="hero__title">{hero.name}</h1>
    <p
      class="hero__lines"
      data-effect="typewriter"
      data-effect-priority="high"
      data-effect-options='{"speed":70,"waitForIntro":true}'
      data-type-early
    >
      {hero.lines.map((l) => <span class="hero__line">{l}</span>)}
    </p>
    <p class="hero__tagline">
      {hero.tagline.before}<em class="glitch"
        ><span class="glitch__base">{hero.tagline.glitch}</span><span class="glitch__layer glitch__layer--a" aria-hidden="true"
          >{hero.tagline.glitch}</span
        ><span class="glitch__layer glitch__layer--b" aria-hidden="true">{hero.tagline.glitch}</span></em
      >{hero.tagline.after}
    </p>
  </div>

  <canvas class="hero__dust" aria-hidden="true" data-effect="film-dust"></canvas>

  <div class="ink-edge" aria-hidden="true" data-effect="ink-edge" data-effect-options='{"rest":0.18}'>
    <InkEdgeFallback rest={0.18} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--void);
    overflow-x: clip; /* not y: the ink edge drips down into Chapter I */
  }

  /* ---- collage (positions measured from the 1440 × 900 Canva frame) ---- */
  .hero__collage {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    pointer-events: none;
  }
  .hero__collage :global(img) {
    position: absolute;
    height: auto;
  }
  .hero__newspaper {
    top: 0;
    right: 0;
    width: min(34.5vw, 620px);
  }
  .hero__eye {
    left: 81.6%;
    top: 33.8%;
    width: clamp(90px, 11.2vw, 190px);
  }
  .hero__moth {
    left: 51.5%;
    top: 68%;
    width: clamp(80px, 9.6vw, 160px);
    filter: grayscale(1) brightness(0.75);
  }
  .hero__hand {
    left: 0;
    bottom: -9%;
    width: clamp(120px, 15vw, 250px);
    filter: brightness(0.42);
  }

  /* ---- text ---- */
  .hero__proceed {
    position: absolute;
    z-index: var(--z-content);
    left: 4.7vw;
    top: 13%;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--muted);
    text-decoration: none;
  }
  .hero__proceed:hover,
  .hero__proceed:focus-visible {
    color: var(--bone);
  }
  .hero__content {
    position: absolute;
    z-index: var(--z-content);
    left: 4.7vw;
    top: 29.5%;
    max-width: min(580px, 46vw);
  }
  .hero__kicker {
    color: var(--muted);
  }
  .hero__title {
    margin-top: clamp(1rem, 4.5svh, 2.6rem);
    font-family: var(--font-display);
    font-size: clamp(5rem, 2rem + 11vw, 14rem);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: 0.01em;
    color: var(--bone);
  }
  .hero__lines {
    margin-top: clamp(1rem, 3.5svh, 2.25rem);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.45;
    letter-spacing: 0.12em;
    color: var(--bone);
    white-space: pre-line;
    min-height: 4.35em;
  }
  .hero__line {
    display: block;
  }
  :global(html.js) .hero__lines[data-type-early] {
    /* hidden until the typewriter starts, so the lines never flash in full first */
    visibility: hidden;
  }
  .hero__tagline {
    margin-top: var(--space-4);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---- glitch: "keeps me awake" slips out of register now and then ---- */
  .glitch {
    position: relative;
    display: inline-block;
    font-style: italic;
  }
  .glitch__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
  }
  .glitch__layer--a {
    color: var(--blood-lit);
    animation: glitch-a 4.2s steps(1, end) infinite;
  }
  .glitch__layer--b {
    color: var(--moon);
    animation: glitch-b 4.2s steps(1, end) infinite;
  }
  .glitch__base {
    display: inline-block;
    animation: glitch-base 4.2s steps(1, end) infinite;
  }
  /* each burst is ~250 ms out of 4.2 s: well under 3 flashes a second */
  @keyframes glitch-a {
    0%,
    86% {
      opacity: 0;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
    87% {
      opacity: 0.85;
      transform: translate(-3px, 1px);
      clip-path: inset(10% 0 55% 0);
    }
    89% {
      opacity: 0.85;
      transform: translate(4px, -1px);
      clip-path: inset(60% 0 8% 0);
    }
    91% {
      opacity: 0.7;
      transform: translate(-2px, 0);
      clip-path: inset(35% 0 35% 0);
    }
    93%,
    100% {
      opacity: 0;
    }
  }
  @keyframes glitch-b {
    0%,
    86% {
      opacity: 0;
      transform: none;
    }
    88% {
      opacity: 0.7;
      transform: translate(3px, 0);
      clip-path: inset(45% 0 20% 0);
    }
    90% {
      opacity: 0.6;
      transform: translate(-4px, 1px);
      clip-path: inset(5% 0 70% 0);
    }
    92%,
    100% {
      opacity: 0;
    }
  }
  @keyframes glitch-base {
    0%,
    86% {
      transform: none;
    }
    88% {
      transform: skewX(-8deg) translateX(2px);
    }
    90% {
      transform: translateX(-2px);
    }
    92%,
    100% {
      transform: none;
    }
  }

  /* ---- film dust (effects/film-dust) ---- */
  .hero__dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-content);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .ink-edge {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - 8vh);
    height: 45vh;
    z-index: var(--z-webgl);
    pointer-events: none;
  }
  .ink-edge[data-webgl='on'] :global(.ink-fallback) {
    visibility: hidden;
  }

  @media (max-width: 899px) {
    .hero__newspaper {
      width: 52vw;
    }
    .hero__proceed {
      left: var(--gutter);
      top: var(--space-5);
    }
    .hero__content {
      left: var(--gutter);
      right: var(--gutter);
      top: 24%;
      max-width: none;
    }
    .hero__eye {
      left: auto;
      right: 6%;
      top: 30%;
    }
    .hero__moth {
      left: 10%;
      top: 66%;
    }
  }
</style>
