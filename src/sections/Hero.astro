---
import { Image, Picture } from 'astro:assets';
import { hero, ui } from '../content/site';
import { heroPortrait, collage } from '../content/photos';
import InkEdgeFallback from '../components/scene/InkEdgeFallback.astro';
import Icon from '../components/Icon.astro';
---

<section id="top" class="hero" data-tone="void" aria-labelledby="hero-title">
  <!-- Someone is sitting in the dark, and she isn't alone. You only see what the light touches. -->
  <div class="hero__dark" aria-hidden="true" data-effect="lantern-reveal">
    <div class="hero__portrait">
      <Picture
        src={heroPortrait}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 768]}
        sizes="(max-width: 719px) 90vw, 46vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <Image class="secret secret--eye" data-watch src={collage.eye} alt="" width={180} loading="lazy" decoding="async" />
    <Image class="secret secret--hand" src={collage.hand} alt="" width={260} loading="lazy" decoding="async" />
    <Image class="secret secret--moth" src={collage.butterfly} alt="" width={200} loading="lazy" decoding="async" />
  </div>

  <div class="hero__content" data-effect="flicker-jitter" data-effect-options='{"every":[9,20]}'>
    <p class="hero__kicker label">{hero.kicker}</p>
    <h1 id="hero-title" class="hero__title" data-effect="ghost-title" data-effect-options='{"every":[6,14]}'>{hero.name}</h1>
    <span class="hero__rule" aria-hidden="true"></span>
    <p class="hero__tagline label">{hero.tagline}</p>
    <p class="hero__sub">{hero.sub}</p>
  </div>

  <a class="hero__scroll label" href="#rabbit-hole">
    {ui.scrollHint}
    <Icon name="arrow-down" size={20} />
  </a>

  <div class="ink-edge" aria-hidden="true" data-effect="ink-edge" data-effect-options='{"rest":0.18}'>
    <InkEdgeFallback rest={0.18} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding: var(--space-8) var(--gutter) calc(var(--space-7) + 6vh);
    background:
      radial-gradient(ellipse 60% 50% at 70% 35%, rgb(26 25 34 / 0.55), transparent 70%),
      var(--void);
  }

  /* The dark layer: barely there everywhere, uncovered only where the light falls. */
  .hero__dark {
    --lx: 62%;
    --ly: 34%;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image:
      radial-gradient(circle 280px at var(--lx) var(--ly), #000 0, rgb(0 0 0 / 0.6) 45%, transparent 100%),
      linear-gradient(rgb(0 0 0 / 0.06), rgb(0 0 0 / 0.06));
    mask-image:
      radial-gradient(circle 280px at var(--lx) var(--ly), #000 0, rgb(0 0 0 / 0.6) 45%, transparent 100%),
      linear-gradient(rgb(0 0 0 / 0.06), rgb(0 0 0 / 0.06));
  }
  .hero__portrait {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 4vw;
    width: min(46vw, 620px);
  }
  .hero__portrait :global(picture),
  .hero__portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
    filter: grayscale(1) contrast(1.2) brightness(0.8);
  }
  .hero__portrait::after {
    /* melt her edges into the dark */
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--void), transparent 30%, transparent 75%, var(--void)),
      linear-gradient(to bottom, transparent 60%, var(--void));
  }
  .secret {
    position: absolute;
    height: auto;
    filter: grayscale(1) contrast(1.1);
  }
  .secret--eye {
    width: clamp(90px, 11vw, 170px);
    left: 38%;
    top: 14%;
    transform: rotate(-8deg);
  }
  .secret--hand {
    width: clamp(130px, 16vw, 250px);
    left: 2%;
    bottom: 4%;
    transform: rotate(18deg);
  }
  .secret--moth {
    width: clamp(90px, 10vw, 180px);
    left: 52%;
    top: 64%;
    transform: rotate(-14deg);
  }
  @property --lx {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 62%;
  }
  @property --ly {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 34%;
  }
  .hero__dark:global(.is-drifting) {
    animation: lantern-drift 23s ease-in-out infinite alternate;
  }
  @keyframes lantern-drift {
    0% {
      --lx: 62%;
      --ly: 30%;
    }
    30% {
      --lx: 40%;
      --ly: 18%;
    }
    60% {
      --lx: 70%;
      --ly: 55%;
    }
    100% {
      --lx: 22%;
      --ly: 80%;
    }
  }

  .hero__content {
    position: relative;
    z-index: var(--z-content);
    max-width: 52rem;
    margin-left: clamp(0rem, 3vw, 4rem);
  }
  .hero__kicker {
    color: var(--muted);
    margin-bottom: var(--space-2);
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: var(--step-6);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: var(--bone);
    text-transform: uppercase;
    margin-left: -0.04em;
  }
  .hero__rule {
    display: block;
    width: 3.5rem;
    height: 2px;
    margin-block: var(--space-4) var(--space-3);
    background: var(--blood);
  }
  .hero__tagline {
    color: var(--bone);
    font-size: clamp(var(--text-label), 0.7rem + 0.4vw, 0.95rem);
    max-width: 44ch;
  }
  .hero__sub {
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: var(--step-0);
    max-width: 44ch;
  }
  .hero__scroll {
    position: absolute;
    z-index: var(--z-content);
    left: var(--gutter);
    top: calc(var(--space-2) + var(--touch) + var(--space-3));
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch);
    padding-inline: var(--space-1);
    color: var(--muted);
    text-decoration: none;
  }
  .hero__scroll:hover {
    color: var(--bone);
  }
  .hero__scroll :global(.icon) {
    animation: nudge 2.4s var(--ease-ink) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }

  .ink-edge {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - 8vh);
    height: 45vh;
    z-index: var(--z-webgl);
    pointer-events: none;
  }
  .ink-edge[data-webgl='on'] :global(.ink-fallback) {
    visibility: hidden;
  }

  @media (max-width: 719px) {
    .hero {
      padding-bottom: calc(var(--space-7) + 10vh);
    }
    .hero__portrait {
      right: -10vw;
      width: 90vw;
    }
    .secret--eye {
      left: auto;
      right: 4%;
      top: 4%;
    }
    .secret--moth {
      left: 60%;
      top: 70%;
    }
    .hero__content {
      margin-left: 0;
    }
    .hero__scroll {
      top: auto;
      bottom: calc(10vh + var(--space-3));
    }
  }
</style>
