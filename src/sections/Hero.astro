---
import { Image } from 'astro:assets';
import { haunt, hero, work } from '../content/site';
import MarginNote from '../components/MarginNote.astro';
import { collage, cutouts } from '../content/photos';
---

<!--
  Layout follows Teha's revised Canva hero (1440 × 900). Nothing here that isn't in that design.
  The eye + "Navigate." (bottom right) is the menu button; it lives in SiteNav.
-->
<section id="top" class="hero" data-tone="void" aria-labelledby="hero-title" data-effect="hero-entrance" data-effect-priority="high">
  <div class="hero__collage" aria-hidden="true">
    <Image
      class="hero__newspaper"
      src={collage.newspaper}
      alt=""
      widths={[320, 520, 760, 1000]}
      sizes="(max-width: 899px) 52vw, min(34.5vw, 620px)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- a spray of roses rising in from the bottom corner. They lose their colour while you watch (effects/wilt). -->
    <span class="hero__hand-wrap" data-enter data-perch="0.6 0.34" data-effect="wilt">
      <Image class="hero__hand" src={cutouts.roses} alt="" widths={[320, 640]} sizes="clamp(160px, 22vw, 340px)" loading="eager" decoding="async" />
    </span>
  </div>
  <MarginNote text={haunt.notes.hero} tilt={-4} class="hero__note" />

  <div class="hero__content container">
    <p class="hero__kicker kicker" data-enter>{hero.kicker}</p>
    <h1 id="hero-title" class="hero__title display-1" data-perch="end">{hero.name}</h1>
    <p
      class="hero__lines"
      data-effect="typewriter"
      data-effect-priority="high"
      data-effect-options='{"speed":65,"waitForIntro":true,"delay":900}'
      data-type-early
    >
      {hero.lines.map((l) => <span class="hero__line">{l}</span>)}
    </p>
    <p class="hero__tagline" data-enter>
      {hero.tagline.before}<em class="inked">{hero.tagline.glitch}</em>{hero.tagline.after}
    </p>
    <p class="hero__cta" data-enter>
      <a class="btn hero__work" href="/work/">{work.cta} <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--void);
    overflow-x: clip;
  }

  /* ---- collage (positions measured from the 1440 × 900 Canva frame) ---- */
  .hero__collage {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    pointer-events: none;
  }
  .hero__newspaper {
    position: absolute;
    top: 0;
    right: 0;
    width: min(34.5vw, 620px);
    height: auto;
  }
  /* waits half out of frame (never transparent, so it still counts as painted for LCP) */
  :global(html.js.at-hero:not(.hero-entered)) .hero__newspaper,
  :global(html.js.intro-pending) .hero__newspaper {
    transform: translate(35%, -35%) rotate(8deg);
  }
  .hero__hand-wrap {
    position: absolute;
    left: -2%;
    bottom: -4%;
    width: clamp(160px, 22vw, 340px);
  }
  .hero__hand {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 14px rgb(57 49 47 / 0.18));
    transform-origin: 10% 100%;
    animation: hand-reach 9s var(--ease-ink) infinite;
  }
  /* almost moves: the hand leans in a degree or two, then thinks better of it */
  @keyframes hand-reach {
    0%,
    100% {
      rotate: 0deg;
      translate: 0 0;
    }
    55% {
      rotate: 2deg;
      translate: 4px -6px;
    }
  }

  /* a line in the margin beside the roses (wide screens only: a phone has no margin to spare) */
  .hero :global(.hero__note) {
    position: absolute;
    left: clamp(180px, 24vw, 370px);
    bottom: 6.5%;
    z-index: var(--z-content);
    margin: 0;
    white-space: nowrap;
  }
  @media (max-width: 899px) {
    .hero :global(.hero__note) {
      display: none;
    }
  }

  /* ---- text: on the same column as every section below ---- */
  .hero {
    display: flex;
    align-items: center;
  }
  .hero__content {
    position: relative;
    z-index: var(--z-content);
    padding-block: var(--space-8) var(--space-7);
  }
  .hero__content > * {
    max-width: 38rem;
  }
  .hero__title {
    margin-top: var(--space-5);
    max-width: none;
    /* four letters: the name can carry real size */
    font-size: clamp(5rem, 2rem + 10vw, 11rem);
    color: var(--bone);
    white-space: nowrap;
  }
  .hero__lines {
    margin-top: var(--space-6);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.5;
    letter-spacing: 0.12em;
    color: var(--bone);
    white-space: pre-line;
    min-height: 4.5em;
  }
  .hero__line {
    display: block;
  }
  :global(html.js) .hero__lines[data-type-early] {
    visibility: hidden;
  }
  .hero__tagline {
    margin-top: var(--space-4);
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--muted);
  }
  .hero__cta {
    margin-top: var(--space-5);
  }
  .hero__work {
    position: relative;
    z-index: 1;
    color: var(--bone);
    border-color: var(--line);
    /* solid, so the hand cut-out never shows through the words */
    background: var(--void);
  }
  .hero__work:hover,
  .hero__work:focus-visible {
    border-color: var(--bone);
  }

  /* hidden until hero-entrance animates them in; fail-safe shows them after 8 s regardless */
  :global(html.js.at-hero:not(.hero-entered) [data-enter]),
  :global(html.js.intro-pending [data-enter]) {
    opacity: 0;
    animation: enter-failsafe 0.01s 8s forwards;
  }
  @keyframes enter-failsafe {
    to {
      opacity: 1;
    }
  }

  /* ---- "keeps me awake": olive italic, underlined in ink that draws itself once the hero arrives ---- */
  .inked {
    font-weight: 700;
    color: var(--olive-dk);
    background: linear-gradient(var(--olive), var(--olive)) 0 100% / 0% 2px no-repeat;
    padding-bottom: 2px;
    transition: background-size 1.1s var(--ease-ink) 0.6s;
  }
  :global(html.hero-entered) .inked,
  :global(html:not(.js)) .inked {
    background-size: 100% 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .inked {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .hero__newspaper {
      width: 56vw;
    }
    .hero__title {
      font-size: clamp(5rem, 26vw, 8rem);
    }
  }
</style>
