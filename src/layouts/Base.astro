---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site, ui } from '../content/site';
import HeadInline from '../components/HeadInline.astro';
import SiteNav from '../components/SiteNav.astro';
import SvgDefs from '../components/SvgDefs.astro';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  /** Page ships no canonical (e.g. 404). */
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title,
  description = site.description,
  home = false,
  noindex = false,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#050304" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Preload only what the first screen needs; the rest load on demand. -->
    <Font cssVariable="--font-hero" preload={home} />
    <Font cssVariable="--font-display" preload={!home} />
    <Font cssVariable="--font-label" preload />
    <Font cssVariable="--font-body" />

    <HeadInline intro={home} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <SvgDefs />
    <SiteNav home={home} />
    <slot name="intro" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />

    <div class="atmosphere" aria-hidden="true" data-effect="film-grain" data-effect-eager transition:persist="atmosphere">
      <div class="atmosphere__grain"></div>
      <div class="atmosphere__vignette"></div>
    </div>
    <div class="cursor-host" aria-hidden="true" data-effect="ember-trail" data-effect-eager transition:persist="embers"></div>

    <script>
      import { startEffects, stopEffects } from '../effects/runtime';
      import { startSmoothScroll, ScrollTrigger } from '../lib/motion';
      import { applyHints } from '../lib/hints';

      startSmoothScroll();
      // Register effects as soon as this module runs (before window load) so the intro starts
      // on time; astro:page-load re-scans after every client-side navigation.
      startEffects();
      document.addEventListener('astro:page-load', () => {
        applyHints();
        startEffects();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      });
      document.addEventListener('astro:before-swap', () => {
        stopEffects();
        ScrollTrigger.getAll().forEach((t) => t.kill());
      });
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .cursor-host {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-cursor);
  }
</style>
